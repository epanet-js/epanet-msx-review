[TITLE]
L-Town: VCDM discolouration (turbidity) model - 17 shear-strength bands of wall material, continual erosion and regeneration (Furnass et al. 2014, 2019)

; ---------------------------------------------------------------------------
; Variable Condition Discolouration Model (VCDM, University of Sheffield) as an
; EPANET-MSX reaction file for L-Town (ltown-24h.inp). Our own implementation
; of the published equations; see models/literature.md.
;
; Sources:
;  Furnass WR, Collins RP, Husband PS, Sharpe RL, Mounce SR, Boxall JB (2014)
;    Modelling both the continual erosion and regeneration of discolouration
;    material in drinking water distribution systems. Water Sci Technol:
;    Water Supply 14(1):81-90. doi:10.2166/ws.2013.176 (eqs 1-3).
;    White Rose eprint 87035.
;  Furnass WR (2015) PhD thesis, University of Sheffield (Table 6.5: VCDM
;    fitted to the PODDS-CI1 flushing data). etheses.whiterose.ac.uk/10645
;  Furnass WR, Mounce SR, Husband S, Collins RP, Boxall JB (2019) Calibrating
;    and validating a combined accumulation and mobilisation model for water
;    distribution system discolouration using particle swarm optimisation.
;    Smart Water 4:3. doi:10.1186/s40713-019-0015-z
;  Husband S, Boxall J, Sunny I (2023) Simulating long term discolouration
;    behaviour in large diameter trunk mains. Environ Sci: Water Res Technol
;    9(3):756-771. doi:10.1039/d2ew00855f (accumulation period 1.65-1.85 y).
;
; State: relative amount of material phi_i in [0,1] held on the wall at shear
; strength s_i (one wall species per band), as in the VCDM's material
; condition function phi(tau,t):
;   d(phi_i)/dt = -be*(tau_a - s_i)  if tau_a >= s_i and phi_i > 0   (erosion)
;               =  br                if tau_a <  s_i and phi_i < 1   (regeneration)
; Release from 1 m2 of wall, summed over the eroding bands (eq 3):
;   dN/dt = alpha * sum_i w_i * be*(tau_a - s_i)     [TPMU/m2/s, 1 TPMU = 1 NTU.m3]
; Turbidity: dTURB/dt = dN/dt * (wall area / water volume) = dN/dt * 4/D.
; Bands: s_i = 0.01*sqrt(2)^(i-1) Pa, i = 1..17 (0.01 to 2.56 Pa); each band
; holds the material between the geometric midpoints of its neighbours, width
; w_i = s_i*(2^(1/4) - 2^(-1/4)). The published model uses equal widths; L-Town's
; shear spans three orders of magnitude, so the bands are spaced geometrically.
; Applied shear tau_a = rho*U^2*Ff/8 (= rho*u*^2); "Us" cannot be used in this
; MSX version (its name lookup resolves Us to U).
; ---------------------------------------------------------------------------

[OPTIONS]
  AREA_UNITS   M2
  RATE_UNITS   SEC
  SOLVER       EUL          ;the VCDM is integrated with explicit Euler steps (Furnass 2014 eq 2)
  TIMESTEP     60

[SPECIES]
  BULK  TURB   NTU    0.001  0.001   ;turbidity, treated as a concentration
  WALL  PHI01  FRAC   0.001  0.001   ;relative material at strength 0.01 Pa
  WALL  PHI02  FRAC   0.001  0.001   ;relative material at strength 0.01414 Pa
  WALL  PHI03  FRAC   0.001  0.001   ;relative material at strength 0.02 Pa
  WALL  PHI04  FRAC   0.001  0.001   ;relative material at strength 0.02828 Pa
  WALL  PHI05  FRAC   0.001  0.001   ;relative material at strength 0.04 Pa
  WALL  PHI06  FRAC   0.001  0.001   ;relative material at strength 0.05657 Pa
  WALL  PHI07  FRAC   0.001  0.001   ;relative material at strength 0.08 Pa
  WALL  PHI08  FRAC   0.001  0.001   ;relative material at strength 0.1131 Pa
  WALL  PHI09  FRAC   0.001  0.001   ;relative material at strength 0.16 Pa
  WALL  PHI10  FRAC   0.001  0.001   ;relative material at strength 0.2263 Pa
  WALL  PHI11  FRAC   0.001  0.001   ;relative material at strength 0.32 Pa
  WALL  PHI12  FRAC   0.001  0.001   ;relative material at strength 0.4525 Pa
  WALL  PHI13  FRAC   0.001  0.001   ;relative material at strength 0.64 Pa
  WALL  PHI14  FRAC   0.001  0.001   ;relative material at strength 0.9051 Pa
  WALL  PHI15  FRAC   0.001  0.001   ;relative material at strength 1.28 Pa
  WALL  PHI16  FRAC   0.001  0.001   ;relative material at strength 1.81 Pa
  WALL  PHI17  FRAC   0.001  0.001   ;relative material at strength 2.56 Pa
  WALL  MAT    TPMU                 ;material on the wall, TPMU/m2 (formula, reported)
  WALL  TAPP   PA                   ;applied wall shear stress, Pa (formula, reported)

[COEFFICIENTS]
  CONSTANT  LU  1.0     ;metres per network length unit: 1 for SI networks, 0.3048 for US units
; Mobilisation: VCDM fitted to the PODDS-CI1 flushing data (unlined cast iron,
; 95 mm, groundwater), Furnass (2015) Table 6.5 / Furnass et al. (2019) Table 3
  PARAMETER  BE     0.00064   ;beta_e, 1/(Pa.s), erosion rate factor
  PARAMETER  ALPHA  0.593     ;alpha, TPMU/(Pa.m2), material release coefficient
; Regeneration: accumulation period 1/beta_r = 1.75 years (Husband et al. 2023)
  PARAMETER  BR     1.81e-08  ;beta_r, 1/s
  CONSTANT   RHO    1000     ;water density, kg/m3
  CONSTANT   LPM3   1000     ;litres per m3 (NTU = TPMU/m3)
  CONSTANT   S01    0.01   ;band strength, Pa
  CONSTANT   S02    0.0141421   ;band strength, Pa
  CONSTANT   S03    0.02   ;band strength, Pa
  CONSTANT   S04    0.0282843   ;band strength, Pa
  CONSTANT   S05    0.04   ;band strength, Pa
  CONSTANT   S06    0.0565685   ;band strength, Pa
  CONSTANT   S07    0.08   ;band strength, Pa
  CONSTANT   S08    0.113137   ;band strength, Pa
  CONSTANT   S09    0.16   ;band strength, Pa
  CONSTANT   S10    0.226274   ;band strength, Pa
  CONSTANT   S11    0.32   ;band strength, Pa
  CONSTANT   S12    0.452548   ;band strength, Pa
  CONSTANT   S13    0.64   ;band strength, Pa
  CONSTANT   S14    0.905097   ;band strength, Pa
  CONSTANT   S15    1.28   ;band strength, Pa
  CONSTANT   S16    1.81019   ;band strength, Pa
  CONSTANT   S17    2.56   ;band strength, Pa
  CONSTANT   W01    0.00348311   ;band width, Pa
  CONSTANT   W02    0.00492586   ;band width, Pa
  CONSTANT   W03    0.00696621   ;band width, Pa
  CONSTANT   W04    0.00985171   ;band width, Pa
  CONSTANT   W05    0.0139324   ;band width, Pa
  CONSTANT   W06    0.0197034   ;band width, Pa
  CONSTANT   W07    0.0278649   ;band width, Pa
  CONSTANT   W08    0.0394069   ;band width, Pa
  CONSTANT   W09    0.0557297   ;band width, Pa
  CONSTANT   W10    0.0788137   ;band width, Pa
  CONSTANT   W11    0.111459   ;band width, Pa
  CONSTANT   W12    0.157627   ;band width, Pa
  CONSTANT   W13    0.222919   ;band width, Pa
  CONSTANT   W14    0.315255   ;band width, Pa
  CONSTANT   W15    0.445838   ;band width, Pa
  CONSTANT   W16    0.63051   ;band width, Pa
  CONSTANT   W17    0.891675   ;band width, Pa

[TERMS]
  ;lengths and velocities in metres: LU is metres per network length unit
  ULU     U*LU
  TAUA   RHO*ULU^2*Ff/8        ;applied wall shear stress, Pa
  ERO01  BE*(TAUA-S01)*STEP(TAUA-S01)*STEP(PHI01)   ;erosion of band 1, 1/s
  ERO02  BE*(TAUA-S02)*STEP(TAUA-S02)*STEP(PHI02)   ;erosion of band 2, 1/s
  ERO03  BE*(TAUA-S03)*STEP(TAUA-S03)*STEP(PHI03)   ;erosion of band 3, 1/s
  ERO04  BE*(TAUA-S04)*STEP(TAUA-S04)*STEP(PHI04)   ;erosion of band 4, 1/s
  ERO05  BE*(TAUA-S05)*STEP(TAUA-S05)*STEP(PHI05)   ;erosion of band 5, 1/s
  ERO06  BE*(TAUA-S06)*STEP(TAUA-S06)*STEP(PHI06)   ;erosion of band 6, 1/s
  ERO07  BE*(TAUA-S07)*STEP(TAUA-S07)*STEP(PHI07)   ;erosion of band 7, 1/s
  ERO08  BE*(TAUA-S08)*STEP(TAUA-S08)*STEP(PHI08)   ;erosion of band 8, 1/s
  ERO09  BE*(TAUA-S09)*STEP(TAUA-S09)*STEP(PHI09)   ;erosion of band 9, 1/s
  ERO10  BE*(TAUA-S10)*STEP(TAUA-S10)*STEP(PHI10)   ;erosion of band 10, 1/s
  ERO11  BE*(TAUA-S11)*STEP(TAUA-S11)*STEP(PHI11)   ;erosion of band 11, 1/s
  ERO12  BE*(TAUA-S12)*STEP(TAUA-S12)*STEP(PHI12)   ;erosion of band 12, 1/s
  ERO13  BE*(TAUA-S13)*STEP(TAUA-S13)*STEP(PHI13)   ;erosion of band 13, 1/s
  ERO14  BE*(TAUA-S14)*STEP(TAUA-S14)*STEP(PHI14)   ;erosion of band 14, 1/s
  ERO15  BE*(TAUA-S15)*STEP(TAUA-S15)*STEP(PHI15)   ;erosion of band 15, 1/s
  ERO16  BE*(TAUA-S16)*STEP(TAUA-S16)*STEP(PHI16)   ;erosion of band 16, 1/s
  ERO17  BE*(TAUA-S17)*STEP(TAUA-S17)*STEP(PHI17)   ;erosion of band 17, 1/s
  REG01  BR*STEP(S01-TAUA)*STEP(1-PHI01)   ;regeneration of band 1, 1/s
  REG02  BR*STEP(S02-TAUA)*STEP(1-PHI02)   ;regeneration of band 2, 1/s
  REG03  BR*STEP(S03-TAUA)*STEP(1-PHI03)   ;regeneration of band 3, 1/s
  REG04  BR*STEP(S04-TAUA)*STEP(1-PHI04)   ;regeneration of band 4, 1/s
  REG05  BR*STEP(S05-TAUA)*STEP(1-PHI05)   ;regeneration of band 5, 1/s
  REG06  BR*STEP(S06-TAUA)*STEP(1-PHI06)   ;regeneration of band 6, 1/s
  REG07  BR*STEP(S07-TAUA)*STEP(1-PHI07)   ;regeneration of band 7, 1/s
  REG08  BR*STEP(S08-TAUA)*STEP(1-PHI08)   ;regeneration of band 8, 1/s
  REG09  BR*STEP(S09-TAUA)*STEP(1-PHI09)   ;regeneration of band 9, 1/s
  REG10  BR*STEP(S10-TAUA)*STEP(1-PHI10)   ;regeneration of band 10, 1/s
  REG11  BR*STEP(S11-TAUA)*STEP(1-PHI11)   ;regeneration of band 11, 1/s
  REG12  BR*STEP(S12-TAUA)*STEP(1-PHI12)   ;regeneration of band 12, 1/s
  REG13  BR*STEP(S13-TAUA)*STEP(1-PHI13)   ;regeneration of band 13, 1/s
  REG14  BR*STEP(S14-TAUA)*STEP(1-PHI14)   ;regeneration of band 14, 1/s
  REG15  BR*STEP(S15-TAUA)*STEP(1-PHI15)   ;regeneration of band 15, 1/s
  REG16  BR*STEP(S16-TAUA)*STEP(1-PHI16)   ;regeneration of band 16, 1/s
  REG17  BR*STEP(S17-TAUA)*STEP(1-PHI17)   ;regeneration of band 17, 1/s
  REL    ALPHA*(W01*ERO01+W02*ERO02+W03*ERO03+W04*ERO04+W05*ERO05+W06*ERO06+W07*ERO07+W08*ERO08+W09*ERO09+W10*ERO10+W11*ERO11+W12*ERO12+W13*ERO13+W14*ERO14+W15*ERO15+W16*ERO16+W17*ERO17)   ;dN/dt, TPMU/m2/s (eq 3)

[PIPES]
  RATE     PHI01  REG01-ERO01
  RATE     PHI02  REG02-ERO02
  RATE     PHI03  REG03-ERO03
  RATE     PHI04  REG04-ERO04
  RATE     PHI05  REG05-ERO05
  RATE     PHI06  REG06-ERO06
  RATE     PHI07  REG07-ERO07
  RATE     PHI08  REG08-ERO08
  RATE     PHI09  REG09-ERO09
  RATE     PHI10  REG10-ERO10
  RATE     PHI11  REG11-ERO11
  RATE     PHI12  REG12-ERO12
  RATE     PHI13  REG13-ERO13
  RATE     PHI14  REG14-ERO14
  RATE     PHI15  REG15-ERO15
  RATE     PHI16  REG16-ERO16
  RATE     PHI17  REG17-ERO17
  RATE     TURB   LPM3*Av*REL
  FORMULA  MAT    ALPHA*(W01*PHI01+W02*PHI02+W03*PHI03+W04*PHI04+W05*PHI05+W06*PHI06+W07*PHI07+W08*PHI08+W09*PHI09+W10*PHI10+W11*PHI11+W12*PHI12+W13*PHI13+W14*PHI14+W15*PHI15+W16*PHI16+W17*PHI17)
  FORMULA  TAPP   TAUA

[TANKS]
  RATE     TURB   0                   ;mobilised material stays entrained

[QUALITY]
  GLOBAL  TURB  0.1
  NODE    R1    TURB  0.1
  NODE    R2    TURB  0.1
; Initial wall state polarised at a conditioning strength tau_c (the VCDM's
; "single cusp" boundary condition, Furnass 2015 5.8.3): phi = 0 below tau_c,
; 1 above. As in ltown-podds.msx, tau_c is half of each pipe's peak shear
; in this 24 h run, with a floor of 0.02 Pa: the GLOBAL lines give the floor,
; the LINK lines empty the further bands below tau_c in the other pipes.
  GLOBAL  PHI01  0
  GLOBAL  PHI02  0
  GLOBAL  PHI03  1
  GLOBAL  PHI04  1
  GLOBAL  PHI05  1
  GLOBAL  PHI06  1
  GLOBAL  PHI07  1
  GLOBAL  PHI08  1
  GLOBAL  PHI09  1
  GLOBAL  PHI10  1
  GLOBAL  PHI11  1
  GLOBAL  PHI12  1
  GLOBAL  PHI13  1
  GLOBAL  PHI14  1
  GLOBAL  PHI15  1
  GLOBAL  PHI16  1
  GLOBAL  PHI17  1
  LINK  p1  PHI03  0
  LINK  p1  PHI04  0
