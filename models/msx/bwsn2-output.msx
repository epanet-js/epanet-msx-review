[TITLE]
BWSN2: two first-order decaying species, every node and link reported

[OPTIONS]
  RATE_UNITS DAY
  SOLVER EUL
  TIMESTEP 300

[SPECIES]
  BULK S1 MG
  BULK S2 MG

[COEFFICIENTS]
  CONSTANT k1 0.1
  CONSTANT k2 0.2

[PIPES]
  RATE S1 -k1*S1
  RATE S2 -k2*S2

[TANKS]
  RATE S1 -k1*S1
  RATE S2 -k2*S2

[QUALITY]
  GLOBAL S1 0.6
  GLOBAL S2 0.7
  NODE RESERVOIR-12523 S1 1.0
  NODE RESERVOIR-12523 S2 1.2
  NODE RESERVOIR-12524 S2 1.2

[REPORT]
  NODES ALL
  LINKS ALL
  SPECIES S1 YES
  SPECIES S2 YES
