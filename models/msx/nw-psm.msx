[TITLE]
Two-source parallel second-order (2R/2RA) chlorine reactions, EXBRUF wall reaction, THM and HAA (after Kastl et al. 1999; Fisher et al. 2011, 2012, 2015, 2017, 2023)
; Written by tools/private-reactions.py from models/msx/ltown-psm.msx for nwmodel-12h.inp.
; Sources, equations and assumptions: models/literature.md.

[OPTIONS]
  AREA_UNITS  M2             ;not used (no wall species); as in Fisher's listing
  RATE_UNITS  HR             ;rates in concentration per hour
  SOLVER      RK5            ;as in Fisher 2023 WER Table 4
  COUPLING    NONE           ;no equilibrium equations
  TIMESTEP    300            ;s
  RTOL        0.001          ;as in Fisher 2023 WER Table 4
  ATOL        0.0001         ;as in Fisher 2023 WER Table 4

[SPECIES]
  BULK  CL    MG             ;free chlorine [mg/L]
  BULK  FA    MG             ;fast reducing agents of water A (R1) [mg Cl-equiv/L]
  BULK  SA    MG             ;slow reducing agents of water A (R1) [mg Cl-equiv/L]
  BULK  FB    MG             ;fast reducing agents of water B (R2) [mg Cl-equiv/L]
  BULK  SB    MG             ;slow reducing agents of water B (R2) [mg Cl-equiv/L]
  BULK  THM   MG             ;total trihalomethanes [mg/L]
  BULK  HAA   MG             ;haloacetic acids [mg/L]

[COEFFICIENTS]
  CONSTANT  LU  0.3048     ;metres per network length unit: 1 for SI networks, 0.3048 for US units
; water temperature for this run [C]
  CONSTANT  TC     20.0
; water A (R1), Greenvale: 2RA coefficients at 20 C
  CONSTANT  KFA20  0.164      ;fast rate coefficient [L/mg/h]
  CONSTANT  KSA20  0.00496    ;slow rate coefficient [L/mg/h]
  CONSTANT  EORA   10500      ;activation energy / gas constant [K]
; water B (R2), Mirrabooka: 2RA coefficients at 20 C
  CONSTANT  KFB20  0.0054     ;fast rate coefficient [L/mg/h]
  CONSTANT  KSB20  0.0017     ;slow rate coefficient [L/mg/h]
  CONSTANT  EORB   1300       ;activation energy / gas constant [K]
; by-product yields (Fisher 2023 WER defaults)
  CONSTANT  KTHM   0.043      ;[mg THM / mg Cl reacted]
  CONSTANT  KHAA   0.020      ;[mg HAA / mg Cl reacted]
; EXBRUF wall reaction (Fisher 2023 WER Tables 5-6, Mirrabooka pipeline)
  CONSTANT  ABF20  1000       ;biofilm activity at zero chlorine and 20 C [dm/h]
  CONSTANT  BBF    26         ;decrease of biofilm activity with chlorine [L/mg]
  CONSTANT  EORW   5000       ;wall E/R [K] ("typical" value in Fisher 2023 WER)
  CONSTANT  EPS    0.0025     ;absolute pipe roughness [m] (Fisher 2023 WER Table 6)

[TERMS]
  ;lengths and velocities in metres: LU is metres per network length unit
  DLU     D*LU
  LLU     Len*LU
; Arrhenius factors relative to 20 C (2RA model)
  TCA     exp(EORA*(TC-20)/(20+273)/(TC+273))
  TCB     exp(EORB*(TC-20)/(20+273)/(TC+273))
  TCW     exp(EORW*(TC-20)/(20+273)/(TC+273))
; bulk reactions of each water's reactants with the common chlorine pool [mg/L/h]
  RFA     -KFA20*TCA*CL*FA
  RSA     -KSA20*TCA*CL*SA
  RFB     -KFB20*TCB*CL*FB
  RSB     -KSB20*TCB*CL*SB
  RB      RFA + RSA + RFB + RSB
; water properties at TC (Fisher 2023 WER eqs 11-12)
  KV      exp(-3.7188 + 578.92/(TC + 135.56))*1E-6   ;kinematic viscosity [m2/s]
  DCL     (0.0365*TC + 0.5176)*1E-9                   ;chlorine diffusivity [m2/s]
  SC      KV/DCL                                      ;Schmidt number
; Sherwood number. Turbulent: Gnielinski with Swamee-Jain friction factor
  RET     Re + STEP(2300 - Re)*(2300 - Re)            ;Re, but at least 2300
  LGF     LOG10(0.27*EPS/DLU + 5.74/(RET^0.9))
  FD8     0.25/(LGF*LGF)/8                            ;Darcy friction factor / 8
  SC66    SC^0.66
  SHT     FD8*(RET - 1000)*SC/(1 + 12.7*(FD8^0.5)*(SC66 - 1))
; laminar: EPANET's developing-flow form
  GZ      DLU*Re*SC/LLU
  SHL     3.65 + 0.0668*GZ/(1 + 0.04*(GZ^0.6667))
  SH      SHL + STEP(Re - 2300)*(SHT - SHL)
  KM      SH*DCL*10/DLU*3600                            ;mass-transfer coefficient [dm/h]
; EXBRUF wall reaction
  BA      ABF20*TCW*exp(-BBF*CL)                      ;biofilm activity [dm/h]
  RW      -BA*CL/(1 + BA/KM)                          ;wall reaction [mg/dm2/h]
  RP      RB + 4/(DLU*10)*RW                            ;total chlorine rate in a pipe [mg/L/h]

[PIPES]
  RATE  CL   RP
  RATE  FA   RFA
  RATE  SA   RSA
  RATE  FB   RFB
  RATE  SB   RSB
  RATE  THM  -KTHM*RP
  RATE  HAA  -KHAA*RP

[TANKS]
; bulk reactions only
  RATE  CL   RB
  RATE  FA   RFA
  RATE  SA   RSA
  RATE  FB   RFB
  RATE  SB   RSB
  RATE  THM  -KTHM*RB
  RATE  HAA  -KHAA*RB

[QUALITY]
  GLOBAL  CL   0.473
  GLOBAL  FA   0.301
  GLOBAL  SA   1.408
  GLOBAL  FB   2.002
  GLOBAL  SB   24.76
  GLOBAL  THM  0.0227
  GLOBAL  HAA  0.0105
  NODE  7384  CL  1.0
  NODE  7384  FA  1.13
  NODE  7384  SA  2.87
  NODE  7384  FB  0.0
  NODE  7384  SB  0.0
  NODE  7384  THM  0.0
  NODE  7384  HAA  0.0
  NODE  311  CL  1.0
  NODE  311  FA  0.0
  NODE  311  SA  0.0
  NODE  311  FB  4.1
  NODE  311  SB  49.9
  NODE  311  THM  0.0
  NODE  311  HAA  0.0
  NODE  RES9000  CL  1.0
  NODE  RES9000  FA  1.13
  NODE  RES9000  SA  2.87
  NODE  RES9000  FB  0.0
  NODE  RES9000  SB  0.0
  NODE  RES9000  THM  0.0
  NODE  RES9000  HAA  0.0

[REPORT]
  SPECIES  CL   YES  3
  SPECIES  THM  YES  4
