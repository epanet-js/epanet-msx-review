+// linksolve() solves a link's system with a recurrence (see there) while the
+// diagonal elements of the system are below LINKSOLVE_BMAX; any other system (it
+// takes a segment of next to no volume) goes to tridiag3(). The recurrence
+// scales the determinants p of the leading rows of the system by
+// LINKSOLVE_PSCALE whenever they pass LINKSOLVE_PBIG, which it checks every 4
+// rows: p cannot get beyond PBIG * BMAX^4 = 1e200 within a block and is below
+// BMAX^4 = 1e100 after a scaling, so it never overflows.
+#define LINKSOLVE_BMAX   1.0e25
+#define LINKSOLVE_PBIG   1.0e100
+#define LINKSOLVE_PSCALE 1.0e-100
+
 static void freelinkseg()
 {
 	int k;
@@ -259,18 +271,165 @@ static void linkhydraulics(int k, int m, double d0, SdispHyd *hc)
 	hc->h2 = MSX.H[MSX.Link[k].n2];
