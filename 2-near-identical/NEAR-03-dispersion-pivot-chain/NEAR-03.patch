+// Find the responses of link k's segments (hresponse, dresponse, uresponse)
+// to species m's concentrations, to a unit concentration at the downstream end
+// and to one at the upstream end, after one time step of dispersion: build the
+// link's tri-diagonal system from its segments (downstream to upstream) and
+// solve it for the three right-hand sides. The segments are kept in linkseg[k]
+// (their number in linksegn[k]). If disperse is 0 the responses are those of a
+// link without dispersion.
+//
+// The system is solved while it is built, because the solution of its first
+// j rows needs only the segments up to j+1 and walking along the list of
+// segments (where the memory is) takes as long as the elimination: the two
+// overlap. The elimination is that of tridiag3(), but without the division in
+// its chain of dependencies: the pivots are bet(j) = p(j) / p(j-1) with
+// p(j) = b(j) p(j-1) - a(j) c(j-1) p(j-2), the determinant of the first j+1 rows
+// (p(-1) = 1, p(0) = b(0) = 1), so p(j) takes a multiplication and a
+// subtraction after p(j-1), and the divisions for the bet(j) do not wait for
+// each other. The other divisions are multiplications by 1 / bet(j). The
+// right-hand side at the upstream end is zero except in the last row, which is
+// the unit vector (its pivot is 1), so there the responses are known:
+// 0, 0 and 1. The results differ from tridiag3()'s by rounding (about 1e-14
+// relative).
+
+static void linksolve(int k, int m, double cons, int disperse)
+{
+	Pseg  seg = MSX.FirstSeg[k];           // downstream
+	Pseg* segp = linkseg[k];
+	int   cap = linksegcap[k];
+	int   nseg = 0, j, last;
+	int   slow = 0;
+	double vd = 0.0, vu, vself, ca, cc, b, rj;
+	double cprev = 0.0;                    // c(j-1)
+	double p1 = 1.0, p2 = 1.0, pj, inv = 1.0, ainv, q, g;
+	double y1 = 0.0, y2 = 1.0, z1, z2, z3;
+	double *s1 = sol, *s2 = sold, *gm = gam;
+
+	if (cap < MSX.Link[k].nsegs + 2)
+	{
+		segp = growlinkseg(k, MSX.Link[k].nsegs);
+		cap = linksegcap[k];
+	}
+	s1[0] = 0.0;                           // row 0, the downstream boundary
+	s2[0] = 1.0;                           // (b = 1, c = 0, r = 0)
+	gm[0] = 0.0;
+	while (seg != NULL && segp != NULL)
+	{
+		// --- up to 4 rows between checks of the size of p
+		last = nseg + 4;
+		while (seg != NULL && nseg < last)
+		{
+			nseg++;
+			if (nseg + 1 >= cap)
+			{
+				segp = growlinkseg(k, nseg);
+				if (segp == NULL)
+					break;
+				cap = linksegcap[k];
+			}
+			segp[nseg] = seg;
+			vself = seg->v;
+			rj = seg->c[m];
+			seg = seg->prev;
+			if (seg)
+				vu = seg->v;
+			else
+				vu = 0.0;
+			ca = -cons / (vself * vself + vself * vd);
+			cc = -cons / (vself * vself + vself * vu);
+			b = 1 - ca - cc;
+			vd = vself;
+			slow |= (b >= LINKSOLVE_BMAX);
+
+			g = cprev * inv;
+			q = ca * cprev;
+			pj = b * p1 - q * p2;
+			inv = p1 / pj;
+			ainv = ca * inv;
+			y1 = rj * inv - ainv * y1;
+			y2 = -ainv * y2;
+			gm[nseg] = g;
+			s1[nseg] = y1;
+			s2[nseg] = y2;
+			p2 = p1;
+			p1 = pj;
+			cprev = cc;
+		}
+		if (segp == NULL)
+			break;
+		if (p1 > LINKSOLVE_PBIG)
+		{
+			p1 *= LINKSOLVE_PSCALE;
+			p2 *= LINKSOLVE_PSCALE;
+		}
+	}
+	linksegn[k] = (segp != NULL) ? nseg : 0;
+	if (nseg == 0 || segp == NULL)
+		return;
+
+	if (!disperse)
+	{
+		for (j = 1; j <= nseg; j++)
+		{
+			segp[j]->hresponse = segp[j]->c[m];
+			segp[j]->dresponse = 0.0;
+			segp[j]->uresponse = 0.0;
+		}
+		return;
+	}
+	if (slow)
+	{
+		// --- a diagonal element is out of the range of the recurrence:
+		//     build the system and solve it with tridiag3()
+		for (j = 1; j <= nseg; j++)
+		{
+			vself = segp[j]->v;
+			vd = (j > 1) ? segp[j - 1]->v : 0.0;
+			vu = (j < nseg) ? segp[j + 1]->v : 0.0;
+			al[j] = -cons / (vself * vself + vself * vd);
+			cl[j] = -cons / (vself * vself + vself * vu);
+			bl[j] = 1 - al[j] - cl[j];
+			rl[j] = segp[j]->c[m];
+		}
+		bl[0] = 1.0;
+		cl[0] = 0.0;
+		rl[0] = 0.0;
+		al[nseg + 1] = 0.0;
+		bl[nseg + 1] = 1.0;
+		rl[nseg + 1] = 0.0;
+		tridiag3(nseg + 2, al, bl, cl, rl, segp);
+		return;
+	}
+
+	// --- back substitution, from the upstream end to row 1 (row 0, the
+	//     downstream boundary, is not needed)
+	z1 = 0.0;
+	z2 = 0.0;
+	z3 = 1.0;
+	g = cprev * inv;
+	for (j = nseg; j >= 1; j--)
+	{
+		z1 = s1[j] - g * z1;
+		z2 = s2[j] - g * z2;
+		z3 = -g * z3;
+		segp[j]->hresponse = z1;
+		segp[j]->dresponse = z2;
+		segp[j]->uresponse = z3;
+		g = gm[j];
+	}
+}
