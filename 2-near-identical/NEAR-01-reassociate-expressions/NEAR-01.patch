 //=============================================================================
 
+static int sameTree(SNode* a, SNode* b)
+{
+    if (a == b) return 1;
+    if (a == NULL || b == NULL || a->opcode != b->opcode) return 0;
+    if (a->opcode == 7) return memcmp(&a->fvalue, &b->fvalue, sizeof(double)) == 0;
+    if (a->opcode == 8) return a->ivar == b->ivar;
+    return sameTree(a->left, b->left) && sameTree(a->right, b->right);
+}
+
+//=============================================================================
+
+static int satom(Simplifier* s, SNode* t)
+//  id of a factor (the same for trees of the same form)
+{
+    int i;
+    for (i = 0; i < s->nAtoms; i++) if (sameTree(s->atom[i], t)) return i;
+    if (s->nAtoms >= s->maxAtoms) longjmp(s->fail, 1);
+    s->atom[s->nAtoms] = t;
+    return s->nAtoms++;
+}
+
+//=============================================================================
+
+static SSum* newSum(Simplifier* s)
+{
+    if (s->nSums >= s->maxSums) longjmp(s->fail, 1);
+    s->sum[s->nSums].n = 0;
+    return &s->sum[s->nSums++];
+}
+
+//=============================================================================
+
+static SSum* sexpand(Simplifier* s, SNode* t)
+//  expands a tree into a sum of terms, each a fixed coefficient times
+//  other factors (NULL if there would be too many terms or factors)
+{
+    SSum *a, *b, *r;
+    STerm *ta, *tb, *tr;
+    int i, j, k;
+
+    if (!t->fixed && isArith(t->opcode))
+    {
+        a = sexpand(s, t->left);
+        if (a == NULL) return NULL;
+        switch (t->opcode)
+        {
+        case 9:
+            for (i = 0; i < a->n; i++) a->t[i].neg = !a->t[i].neg;
+            return a;
+
+        case 3:
+        case 4:
+            b = sexpand(s, t->right);
+            if (b == NULL || a->n + b->n > MAX_TERMS) return NULL;
+            for (i = 0; i < b->n; i++)
+            {
+                a->t[a->n] = b->t[i];
+                if (t->opcode == 4) a->t[a->n].neg = !b->t[i].neg;
+                a->n++;
+            }
+            return a;
+
+        case 5:
+            b = sexpand(s, t->right);
+            if (b == NULL || a->n * b->n > MAX_TERMS) return NULL;
+            r = newSum(s);
+            for (i = 0; i < a->n; i++)
+            {
+                for (j = 0; j < b->n; j++)
+                {
+                    ta = &a->t[i];
+                    tb = &b->t[j];
+                    if (ta->n + tb->n > MAX_ATOMS) return NULL;
+                    tr = &r->t[r->n++];
+                    *tr = *ta;
+                    tr->neg = (ta->neg != tb->neg);
+                    if (ta->coef == NULL) tr->coef = tb->coef;
+                    else if (tb->coef) tr->coef = snode(s, 5, ta->coef, tb->coef);
+                    for (k = 0; k < tb->n; k++)
+                    {
+                        tr->atom[tr->n] = tb->atom[k];
+                        tr->inv[tr->n] = tb->inv[k];
+                        tr->n++;
+                    }
+                }
+            }
+            return r;
+
+        case 6:
+            if (t->right->fixed)
+            {
+                for (i = 0; i < a->n; i++)
+                {
+                    ta = &a->t[i];
+                    if (ta->coef == NULL) ta->coef = snumber(s, 1.0);
+                    ta->coef = snode(s, 6, ta->coef, t->right);
+                }
+                return a;
+            }
+            k = satom(s, rewrite(s, t->right));
+            for (i = 0; i < a->n; i++)
+            {
+                ta = &a->t[i];
+                if (ta->n >= MAX_ATOMS) return NULL;
+                ta->atom[ta->n] = k;
+                ta->inv[ta->n] = 1;
+                ta->n++;
+            }
+            return a;
+        }
+    }
+
+    // --- a fixed value, or a factor of a term
+
+    r = newSum(s);
+    r->n = 1;
+    tr = &r->t[0];
+    tr->neg = 0;
+    tr->coef = NULL;
+    tr->n = 0;
+    if (t->fixed) tr->coef = t;
+    else
+    {
+        tr->atom[0] = satom(s, t);
+        tr->inv[0] = 0;
+        tr->n = 1;
+    }
+    return r;
+}
+
+//=============================================================================
+
+static int sameFactors(STerm* a, STerm* b)
+//  1 if two terms have the same factors besides their coefficients
+{
+    int ka[MAX_ATOMS], kb[MAX_ATOMS];
+    int i, j, x;
+    if (a->n != b->n) return 0;
+    for (i = 0; i < a->n; i++)
+    {
+        ka[i] = 2 * a->atom[i] + a->inv[i];
+        kb[i] = 2 * b->atom[i] + b->inv[i];
+    }
+    for (i = 1; i < a->n; i++)
+    {
+        for (j = i; j > 0 && ka[j-1] > ka[j]; j--)
+        {
+            x = ka[j]; ka[j] = ka[j-1]; ka[j-1] = x;
+        }
+        for (j = i; j > 0 && kb[j-1] > kb[j]; j--)
+        {
+            x = kb[j]; kb[j] = kb[j-1]; kb[j-1] = x;
+        }
+    }
+    for (i = 0; i < a->n; i++) if (ka[i] != kb[i]) return 0;
+    return 1;
+}
+
+//=============================================================================
+
+static void scollect(Simplifier* s, SSum* sum)
+//  merges terms with the same factors, adding up their coefficients
+{
+    int i, j, k;
+    STerm *a, *b;
+    for (i = 0; i < sum->n; i++)
+    {
+        a = &sum->t[i];
+        for (j = i + 1; j < sum->n; )
+        {
+            b = &sum->t[j];
+            if (!sameFactors(a, b))
+            {
+                j++;
+                continue;
+            }
+            if (a->coef == NULL) a->coef = snumber(s, 1.0);
+            a->coef = snode(s, a->neg == b->neg ? 3 : 4, a->coef,
+                            b->coef ? b->coef : snumber(s, 1.0));
+            for (k = j + 1; k < sum->n; k++) sum->t[k-1] = sum->t[k];
+            sum->n--;
+        }
+    }
+}
+
+//=============================================================================
+
+static SNode* sterm(Simplifier* s, STerm* t)
+//  tree of a term of a sum
+{
+    SNode* r;
+    int i, first = -1;
+
+    // --- start with a factor that is not leaf-like, so that the others
+    //     can be fused into their operators, and the coefficient last
+
+    for (i = 0; i < t->n && first < 0; i++)
+        if (!t->inv[i] && !isLeafLike(s->atom[t->atom[i]])) first = i;
+    for (i = 0; i < t->n && first < 0; i++)
+        if (!t->inv[i]) first = i;
+    if (first >= 0) r = s->atom[t->atom[first]];
+    else r = t->coef ? t->coef : snumber(s, 1.0);
+    for (i = 0; i < t->n; i++)
+    {
+        if (i != first) r = snode(s, t->inv[i] ? 6 : 5, r, s->atom[t->atom[i]]);
+    }
+    if (first >= 0 && t->coef) r = snode(s, 5, r, t->coef);
+    if (t->neg) r = snode(s, 9, r, NULL);
+    return r;
+}
+
+//=============================================================================
+
+static SNode* shorner(Simplifier* s, SSum* sum)
+//  tree of a sum, taking a factor shared by several terms out of them
+//  (the one shared by most first)
+{
+    int i, j, k, m, c, best = -1, bestInv = 0, most = 1;
+    SSum *with, *rest;
+    SNode* r;
+    STerm* t;
+
+    for (i = 0; i < sum->n; i++)
+    {
+        for (k = 0; k < sum->t[i].n; k++)
+        {
+            c = 0;
+            for (j = 0; j < sum->n; j++)
+            {
+                t = &sum->t[j];
+                for (m = 0; m < t->n; m++)
+                {
+                    if (t->atom[m] == sum->t[i].atom[k] &&
+                        t->inv[m] == sum->t[i].inv[k])
+                    {
+                        c++;
+                        break;
+                    }
+                }
+            }
+            if (c > most)
+            {
+                most = c;
+                best = sum->t[i].atom[k];
+                bestInv = sum->t[i].inv[k];
+            }
+        }
+    }
+
+    // --- no factor is shared: add up the terms
+
+    if (best < 0)
+    {
+        r = sterm(s, &sum->t[0]);
+        for (i = 1; i < sum->n; i++) r = snode(s, 3, r, sterm(s, &sum->t[i]));
+        return r;
+    }
+
+    // --- (sum of the terms holding the factor, without it) times the
+    //     factor, plus the other terms
+
+    with = newSum(s);
+    rest = newSum(s);
+    for (i = 0; i < sum->n; i++)
+    {
+        t = &sum->t[i];
+        for (k = 0; k < t->n; k++)
+            if (t->atom[k] == best && t->inv[k] == bestInv) break;
+        if (k == t->n)
+        {
+            rest->t[rest->n++] = *t;
+            continue;
+        }
+        with->t[with->n] = *t;
+        t = &with->t[with->n++];
+        for (k = k + 1; k < t->n; k++)
+        {
+            t->atom[k-1] = t->atom[k];
+            t->inv[k-1] = t->inv[k];
+        }
+        t->n--;
+    }
+    r = snode(s, bestInv ? 6 : 5, shorner(s, with), s->atom[best]);
+    if (rest->n > 0) r = snode(s, 3, r, shorner(s, rest));
+    return r;
+}
