BIT-08: Evaluate Euler rates for eight segments at once

With the Euler integrator a segment's reaction is one evaluation of a
short rate program, and the cost was the overhead around it. For Euler
models without equilibrium or formula species, evaluate the program for
eight segments at a time, one operation across all eight, in a loop the
compiler can vectorise. Each segment's arithmetic is unchanged.

Requires: none
Results: identical (every concentration, the output file and the report are unchanged)

Apply from the root of an EPANET-MSX checkout at 85a303d, after FIX-01, FIX-02 and BIT-01 to BIT-07:
    git apply --whitespace=nowarn BIT-08.patch
or use tools/build-msx.sh, which applies the series in order.

diff --git a/src/solver/mathexpr.c b/src/solver/mathexpr.c
index e3ae1e5..d29a4cd 100644
--- a/src/solver/mathexpr.c
+++ b/src/solver/mathexpr.c
@@ -858,6 +858,211 @@ done:
 
 //=============================================================================
 
+#define LANES       MATHEXPR_LANES
+#define LANE_STACK  32            // stack size of mathexpr_runLanes
+#define EACH(s)     for (l = 0; l < LANES; l++) { s; }
+
+int mathexpr_runLanes(MathExpr* prog, double* values)
+/*
+**  Purpose:
+**    runs a program made by mathexpr_join for MATHEXPR_LANES sets of
+**    variable values at once.
+**
+**  Input:
+**    prog = the program
+**    values = the values of the variables: the value of variable i in
+**             set l is values[i * MATHEXPR_LANES + l].
+**
+**  Output:
+**    the values stored by the program, in values.
+**
+**  Returns:
+**    1, or 0 if the program is not suited to it (not well formed, or
+**    needing a stack of LANE_STACK or more), in which case nothing is done.
+**
+**  Note:
+**    each set of values goes through the same operations as in
+**    mathexpr_run, so the values stored are the same; the operations of
+**    the sets are done side by side, one operation at a time.
+*/
+{
+#ifdef THREADED_CODE
+    static const void* const dispatch[62] = {
+        &&op_end,  &&op_none, &&op_none, &&op_add,  &&op_sub,     // 0-4
+        &&op_mul,  &&op_div,  &&op_num,  &&op_var,  &&op_neg,     // 5-9
+        &&op_cos,  &&op_sin,  &&op_tan,  &&op_cot,  &&op_abs,     // 10-14
+        &&op_sgn,  &&op_sqrt, &&op_log,  &&op_exp,  &&op_asin,    // 15-19
+        &&op_acos, &&op_atan, &&op_acot, &&op_sinh, &&op_cosh,    // 20-24
+        &&op_tanh, &&op_coth, &&op_log10, &&op_step, &&op_none,   // 25-29
+        &&op_none, &&op_pow,  &&op_none, &&op_none, &&op_none,    // 30-34
+        &&op_none, &&op_none, &&op_none, &&op_none, &&op_none,    // 35-39
+        &&op_none, &&op_addv, &&op_subv, &&op_mulv, &&op_divv,    // 40-44
+        &&op_powv, &&op_none, &&op_none, &&op_none, &&op_none,    // 45-49
+        &&op_none, &&op_addn, &&op_subn, &&op_muln, &&op_divn,    // 50-54
+        &&op_pown, &&op_none, &&op_none, &&op_none, &&op_none,    // 55-59
+        &&op_store, &&op_storeraw };                              // 60-61
+#endif
+
+    double stack[LANE_STACK][LANES];
+    double top[LANES], r1[LANES];
+    ExprNode* node;
+#ifndef THREADED_CODE
+    ExprNode* end;
+#endif
+    double *s, *v, x;
+    int sp, l;
+
+    if (prog == NULL || prog->maxDepth < 0 || prog->maxDepth >= LANE_STACK)
+        return 0;
+
+    // --- the values on top of the stack are held in top and those
+    //     beneath them in stack[1..sp]
+
+    EACH(top[l] = 0.0)
+    sp = 0;
+    node = prog->node;
+
+#ifdef THREADED_CODE
+    goto *dispatch[node->opcode];
+#else
+    end = node + prog->count;
+    for (; node < end; node++)
+    {
+        switch (node->opcode)
+        {
+#endif
+        OP(op_add, 3)  s = stack[sp--]; EACH(top[l] = s[l] + top[l])  NEXT;
+        OP(op_sub, 4)  s = stack[sp--]; EACH(top[l] = s[l] - top[l])  NEXT;
+        OP(op_mul, 5)  s = stack[sp--]; EACH(top[l] = s[l] * top[l])  NEXT;
+        OP(op_div, 6)  s = stack[sp--]; EACH(top[l] = s[l] / top[l])  NEXT;
+
+        OP(op_num, 7)
+            s = stack[++sp];
+            x = node->fvalue;
+            EACH(s[l] = top[l]; top[l] = x)
+            NEXT;
+
+        OP(op_var, 8)
+            s = stack[++sp];
+            v = values + (size_t)node->ivar * LANES;
+            EACH(s[l] = top[l]; top[l] = v[l])
+            NEXT;
+
+        OP(op_addv, 41)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(top[l] = top[l] + v[l])
+            NEXT;
+        OP(op_subv, 42)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(top[l] = top[l] - v[l])
+            NEXT;
+        OP(op_mulv, 43)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(top[l] = top[l] * v[l])
+            NEXT;
+        OP(op_divv, 44)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(top[l] = top[l] / v[l])
+            NEXT;
+        OP(op_powv, 45)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(if (top[l] <= 0.0) top[l] = 0.0; else top[l] = pow(top[l], v[l]))
+            NEXT;
+
+        OP(op_addn, 51)  x = node->fvalue; EACH(top[l] = top[l] + x)  NEXT;
+        OP(op_subn, 52)  x = node->fvalue; EACH(top[l] = top[l] - x)  NEXT;
+        OP(op_muln, 53)  x = node->fvalue; EACH(top[l] = top[l] * x)  NEXT;
+        OP(op_divn, 54)  x = node->fvalue; EACH(top[l] = top[l] / x)  NEXT;
+        OP(op_pown, 55)
+            x = node->fvalue;
+            EACH(if (top[l] <= 0.0) top[l] = 0.0; else top[l] = pow(top[l], x))
+            NEXT;
+
+        OP(op_store, 60)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(if (top[l] != top[l]) v[l] = 0.0; else v[l] = top[l])
+            sp = 0;
+            NEXT;
+
+        OP(op_storeraw, 61)
+            v = values + (size_t)node->ivar * LANES;
+            EACH(v[l] = top[l])
+            sp = 0;
+            NEXT;
+
+        OP(op_neg, 9)   EACH(top[l] = -top[l])       NEXT;
+        OP(op_cos, 10)  EACH(top[l] = cos(top[l]))   NEXT;
+        OP(op_sin, 11)  EACH(top[l] = sin(top[l]))   NEXT;
+        OP(op_tan, 12)  EACH(top[l] = tan(top[l]))   NEXT;
+        OP(op_cot, 13)  EACH(top[l] = 1.0 / tan(top[l]))  NEXT;
+        OP(op_abs, 14)  EACH(top[l] = fabs(top[l]))  NEXT;
+
+        OP(op_sgn, 15)
+            EACH(if (top[l] < 0.0) top[l] = -1.0;
+                 else if (top[l] > 0.0) top[l] = 1.0;
+                 else top[l] = 0.0)
+            NEXT;
+
+        OP(op_sqrt, 16) EACH(top[l] = sqrt(top[l]))  NEXT;
+        OP(op_log, 17)  EACH(top[l] = log(top[l]))   NEXT;
+        OP(op_exp, 18)  EACH(top[l] = exp(top[l]))   NEXT;
+        OP(op_asin, 19) EACH(top[l] = asin(top[l]))  NEXT;
+        OP(op_acos, 20) EACH(top[l] = acos(top[l]))  NEXT;
+        OP(op_atan, 21) EACH(top[l] = atan(top[l]))  NEXT;
+        OP(op_acot, 22) EACH(top[l] = 1.57079632679489661923 - atan(top[l]))  NEXT;
+
+        OP(op_sinh, 23)
+            EACH(r1[l] = top[l]; top[l] = (exp(r1[l]) - exp(-r1[l])) / 2.0)
+            NEXT;
+
+        OP(op_cosh, 24)
+            EACH(r1[l] = top[l]; top[l] = (exp(r1[l]) + exp(-r1[l])) / 2.0)
+            NEXT;
+
+        OP(op_tanh, 25)
+            EACH(r1[l] = top[l];
+                 top[l] = (exp(r1[l]) - exp(-r1[l])) / (exp(r1[l]) + exp(-r1[l])))
+            NEXT;
+
+        OP(op_coth, 26)
+            EACH(r1[l] = top[l];
+                 top[l] = (exp(r1[l]) + exp(-r1[l])) / (exp(r1[l]) - exp(-r1[l])))
+            NEXT;
+
+        OP(op_log10, 27) EACH(top[l] = log10(top[l]))  NEXT;
+
+        OP(op_step, 28)
+            EACH(if (top[l] <= 0.0) top[l] = 0.0; else top[l] = 1.0)
+            NEXT;
+
+        OP(op_pow, 31)
+            s = stack[sp--];
+            EACH(r1[l] = top[l]; top[l] = s[l];
+                 if (top[l] <= 0.0) top[l] = 0.0; else top[l] = pow(top[l], r1[l]))
+            NEXT;
+
+#ifdef THREADED_CODE
+        op_none:
+            NEXT;
+        op_end:
+            goto done;
+#else
+        default:
+            break;
+        }
+    }
+#endif
+
+#ifdef THREADED_CODE
+done:
+#endif
+    return 1;
+}
+
+#undef EACH
