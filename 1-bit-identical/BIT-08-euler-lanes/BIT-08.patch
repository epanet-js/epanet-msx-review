+//=============================================================================
+
+int setLanes()
+/*
+**  Purpose:
+**    decides whether the rates of several pipe segments are computed at
+**    once (see evalPipeLanes) and lists the values that the program
+**    computing the rates reads.
+**
+**  Returns:
+**    an error code or 0 if no error.
+*/
+{
+    int j, i, op;
+    char *seen;
+    MathExpr *prog = PipeExprs.rateProg;
+
+    if ( MSX.Solver != EUL || prog == NULL ||
+         NumPipeEquilSpecies + NumPipeFormulaSpecies > 0 ) return 0;
+    seen = (char *)calloc(NumValues, sizeof(char));
+    LaneInputs = (int *)calloc(NumValues, sizeof(int));
+    LaneSpecies = (int *)calloc(NumValues, sizeof(int));
+    if ( !seen || !LaneInputs || !LaneSpecies )
+    {
+        FREE(seen);
+        return ERR_MEMORY;
+    }
+
+// --- values read before the program stores them: species concentrations
+//     and values that are the same throughout a pipe (seen = 1 for those
+//     read, 2 for those stored)
+
+    for (j = 0; j < prog->count; j++)
+    {
+        op = prog->node[j].opcode;
+        i = prog->node[j].ivar;
+        if ( op == 60 || op == 61 )
+        {
+            if ( !seen[i] ) seen[i] = 2;
+        }
+        else if ( (op == 8 || (op >= 41 && op <= 45)) && !seen[i] )
+        {
+            seen[i] = 1;
+            if ( i >= 1 && i <= NumSpecies ) LaneSpecies[NumLaneSpecies++] = i;
+            else LaneInputs[NumLaneInputs++] = i;
+        }
+    }
+    FREE(seen);
+    UseLanes = (prog->maxDepth >= 0 && prog->maxDepth < 32);
+    return 0;
+}
+
+//=============================================================================
+
+int evalPipeLanes(ChemState *cs, int k, double dt)
+/*
+**  Purpose:
+**    updates species concentrations in each WQ segment of a pipe after
+**    reactions over time step dt, with the Euler integrator, computing
+**    the rates of MATHEXPR_LANES segments at once.
+**
+**  Input:
+**    k = link index
+**    dt = time step (sec).
+**
+**  Returns:
+**    an error code or 0 if no error.
+**
+**  Note:
+**    the results are those of evalPipeReactions: each segment's rates
+**    are computed by the same operations (see mathexpr_runLanes), the
+**    segments that hold the same water as the one before them get its
+**    results copied, and the segments are updated in the same order.
+*/
+{
+    int i, j, l, m, n;
+    int nsame[MATHEXPR_LANES];
+    double tstep = (double)dt / MSX.Ucf[RATE_UNITS];
+    double c;
+    double *val = cs->ChemC1;
+    double *lv = cs->Lanes;
+    Pseg seg, src, lane[MATHEXPR_LANES];
+
+    cs->TheLink = k;
+    setPipeValues(cs, k);
+    for (j = 0; j < NumLaneInputs; j++)
+    {
+        i = LaneInputs[j];
+        for (l = 0; l < MATHEXPR_LANES; l++) lv[i * MATHEXPR_LANES + l] = val[i];
+    }
+
+// --- start with the most downstream pipe segment
+
+    seg = MSX.FirstSeg[k];
+    while ( seg )
+    {
+        // --- the next segments that do not hold the same water as the
+        //     one before them, each followed by nsame segments that do
+        //     (the last one is repeated in unused lanes)
+
+        for (n = 0; n < MATHEXPR_LANES && seg; n++)
+        {
+            lane[n] = seg;
+            nsame[n] = 0;
+            for (seg = seg->prev; seg != NULL; seg = seg->prev)
+            {
+                if ( !isSameWater(seg, lane[n]) ) break;
+                nsame[n]++;
+            }
+        }
+        for (j = 0; j < NumLaneSpecies; j++)
+        {
+            m = LaneSpecies[j];
+            for (l = 0; l < MATHEXPR_LANES; l++)
+                lv[m * MATHEXPR_LANES + l] = lane[l < n ? l : n - 1]->c[m];
+        }
+
+        // --- their rates
+
+        mathexpr_runLanes(PipeExprs.rateProg, lv);
+
+        // --- update each segment as evalPipeReactions does, and give
+        //     the segments that follow it with the same water its results
+
+        for (l = 0; l < n; l++)
+        {
+            cs->TheSeg = lane[l];
+            for (m = 1; m <= NumSpecies; m++)
+                cs->TheSeg->lastc[m] = cs->TheSeg->c[m];
+            for (i = 1; i <= NumPipeRateSpecies; i++)
+            {
+                m = PipeRateSpecies[i];
+                cs->Yrate[i] = validate(lv[(OutBase + i) * MATHEXPR_LANES + l],
+                                        m, LINK, RATE);
+            }
+            for (i = 1; i <= NumPipeRateSpecies; i++)
+            {
+                m = PipeRateSpecies[i];
+                c = cs->TheSeg->c[m] + cs->Yrate[i]*tstep;
+                cs->TheSeg->c[m] = MAX(c, 0.0);
+            }
+            addPipeReactedMass(k, cs->TheSeg);
+            src = cs->TheSeg;
+            for (j = 0; j < nsame[l]; j++)
+            {
+                cs->TheSeg = cs->TheSeg->prev;
+                copyPipeReactions(k, src, cs->TheSeg);
+            }
+        }
+    }
+    cs->TheSeg = NULL;
+    return 0;
+}
