+
+//=============================================================================
+
+void  newQualStamp()
+/*
+**  Purpose:
+**    marks all saved link concentrations as out of date (called before
+**    anything that can change concentrations).
+*/
+{
+    QualStamp++;
+    if ( QualStamp == 0 )
+    {
+        if ( LinkQualStamp )
+            memset(LinkQualStamp, 0, (MSX.Nobjects[LINK]+1)*sizeof(unsigned));
+        QualStamp = 1;
+    }
+}
+
+//=============================================================================
+
+void  freeLinkQual()
+{
+    FREE(LinkQual);
+    FREE(LinkQualStamp);
+}
+
+//=============================================================================
+
+double getLinkQual(int k, int m)
+/*
+**  Purpose:
+**    retrieves the current concentration of species m in link k.
+**
+**  Input:
+**    k = link index
+**    m = species index.
+**
+**  Returns:
+**    the same value as MSXqual_getLinkQual(k, m).
+**
+**  Notes:
+**    The first request for a link after a time step finds the concentrations
+**    of all species in that link with one pass over its segments and saves
+**    them, so requests for its other species need no further passes.
+*/
+{
+    int n = MSX.Nobjects[SPECIES] + 1;
+
+    if ( LinkQual == NULL )
+    {
+        LinkQual = (double *) malloc((size_t)(MSX.Nobjects[LINK]+1) * n * sizeof(double));
+        LinkQualStamp = (unsigned *) calloc(MSX.Nobjects[LINK]+1, sizeof(unsigned));
+        if ( LinkQual == NULL || LinkQualStamp == NULL )
+        {
+            freeLinkQual();
+            return MSXqual_getLinkQual(k, m);
+        }
+        if ( QualStamp == 0 ) QualStamp = 1;
+    }
+    if ( LinkQualStamp[k] != QualStamp )
+    {
+        MSXqual_getLinkQuals(k, LinkQual + (size_t)k * n);
+        LinkQualStamp[k] = QualStamp;
+    }
+    return LinkQual[(size_t)k * n + m];
+}
