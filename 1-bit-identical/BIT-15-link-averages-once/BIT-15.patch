diff --git a/src/solver/msxqual.c b/src/solver/msxqual.c
index 5644375..7d7e506 100644
--- a/src/solver/msxqual.c
+++ b/src/solver/msxqual.c
@@ -2157,3 +2157,44 @@ void evalHydVariables(int k)
 
     MSX.Link[k].HydVar[ROUGHNESS] = MSX.Link[k].roughness;
 }
+
+//=============================================================================
+
+void  MSXqual_getLinkQuals(int k, double c[])
+/*
+**   Purpose:
+**     computes the average quality of every species in link k with a
+**     single pass over the link's segments.
+**
+**   Input:
+**     k = link index
+**
+**   Output:
+**     c[m] = WQ value of species m in link k, for m = 1 to the number of
+**            species (the same value as MSXqual_getLinkQual(k, m): each
+**            species' sums are accumulated over the segments in the same
+**            order).
+*/
+{
+    int     m, n = MSX.Nobjects[SPECIES];
+    double  vsum = 0.0;
+    Pseg    seg;
+
+    for (m = 1; m <= n; m++) c[m] = 0.0;
+    seg = MSX.FirstSeg[k];
+    while (seg != NULL)
+    {
+        vsum += seg->v;
+        for (m = 1; m <= n; m++) c[m] += (seg->c[m])*(seg->v);
+        seg = seg->prev;
+    }
+    if (vsum > 0.0)
+    {
+        for (m = 1; m <= n; m++) c[m] = c[m] / vsum;
+    }
+    else for (m = 1; m <= n; m++)
+    {
+        c[m] = (MSXqual_getNodeQual(MSX.Link[k].n1, m) +
+                MSXqual_getNodeQual(MSX.Link[k].n2, m)) / 2.0;
+    }
+}
