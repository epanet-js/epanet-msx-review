+void  openBlock()
+/*
+**  Purpose:
+**    allocates the arrays that hold a block of results read from the
+**    binary output file (if this fails, results are read one at a time).
+*/
+{
+    Block.x = (REAL4 *) malloc(RPTBUFSIZE);
+    Block.slot = (int *) calloc(MSX.Nobjects[SPECIES]+1, sizeof(int));
+    if ( Block.x == NULL || Block.slot == NULL ) closeBlock();
+    Block.objType = -1;
+    Block.first = 0;
+    Block.count = 0;
+    Block.nslots = 0;
+}
+
+//=============================================================================
+
+void  closeBlock()
+{
+    FREE(Block.x);
+    FREE(Block.slot);
+    Block.count = 0;
+}
+
+//=============================================================================
+
+void  loadBlock(int objType, int j)
+/*
+**  Purpose:
+**    makes sure the results of reported node or link j are in memory.
+**
+**  Input:
+**    objType = NODE or LINK
+**    j = index of a reported node or link.
+**
+**  Notes:
+**    If j is not in the current block, a new block is read that starts at
+**    j and runs up to a later reported object, so long as the block fits
+**    in RPTBUFSIZE bytes and no more than RPTMAXGAP unreported objects lie
+**    between two reported ones. Each species and period of the block is
+**    then read with a single fseek and fread.
+*/
+{
+    int  i, k, m, n, last, maxcount;
+    long perObject;
+
+    if ( Block.x == NULL ) return;
+    if ( objType == Block.objType && j >= Block.first &&
+         j < Block.first + Block.count ) return;
+
+// --- assign a slot to each reported species (wall species are not
+//     reported for nodes)
+
+    Block.nslots = 0;
+    for (m = 1; m <= MSX.Nobjects[SPECIES]; m++)
+    {
+        Block.slot[m] = -1;
+        if ( !MSX.Species[m].rpt ) continue;
+        if ( objType == NODE && MSX.Species[m].type == WALL ) continue;
+        Block.slot[m] = Block.nslots++;
+    }
+    Block.objType = objType;
+    Block.first = j;
+    Block.count = 0;
+    if ( Block.nslots == 0 || MSX.Nperiods < 1 ) return;
+
+// --- find the last object of the block
+
+    perObject = (long)MSX.Nperiods * Block.nslots * sizeof(REAL4);
+    maxcount = (int)MIN((long)RPTBUFSIZE / perObject, (long)MSX.Nobjects[objType]);
+    if ( maxcount < 1 ) maxcount = 1;
+    last = j;
+    for (i = j + 1; i <= MSX.Nobjects[objType] && i - j < maxcount; i++)
+    {
+        if ( i - last > RPTMAXGAP ) break;
+        if ( objType == NODE && MSX.Node[i].rpt ) last = i;
+        if ( objType == LINK && MSX.Link[i].rpt ) last = i;
+    }
+    n = last - j + 1;
+
+// --- if a single object's results don't fit, read them one at a time
+
+    if ( perObject > RPTBUFSIZE ) return;
+
+// --- read the block's results for each period and species
+
+    Block.count = n;
+    for (k = 0; k < MSX.Nperiods; k++)
+    {
+        for (m = 1; m <= MSX.Nobjects[SPECIES]; m++)
+        {
+            if ( Block.slot[m] < 0 ) continue;
+            MSXout_getQualBlock(objType, k, m, j, n,
+                Block.x + ((long)k*Block.nslots + Block.slot[m]) * n);
+        }
+    }
+}
+
+//=============================================================================
+
+float getResult(int objType, int k, int j, int m)
+/*
+**  Purpose:
+**    retrieves a result from the current block of results or, if it is not
+**    there, from the binary output file.
+**
+**  Input:
+**    objType = NODE or LINK
+**    k = time period index
+**    j = node or link index
+**    m = species index.
+**
+**  Returns:
+**    the requested species concentration.
+*/
+{
+    if ( objType == Block.objType && j >= Block.first &&
+         j < Block.first + Block.count && Block.slot[m] >= 0 )
+    {
+        return (float)Block.x[((long)k*Block.nslots + Block.slot[m]) *
+                              Block.count + (j - Block.first)];
+    }
+    if ( objType == NODE ) return MSXout_getNodeQual(k, j, m);
+    else return MSXout_getLinkQual(k, j, m);
+}
