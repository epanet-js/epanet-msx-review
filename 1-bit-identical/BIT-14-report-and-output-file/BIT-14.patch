+void  initNumberFormat()
+/*
+**  Purpose:
+**    checks that the C library's decimal point is a single character, so
+**    that putValue() can write the numbers of the tables itself.
+*/
+{
+    char t[32];
+    sprintf(t, "%.1f", 0.5);
+    FastFormat = ( t[0] == '0' && t[1] != '\0' && t[2] == '5' && t[3] == '\0' );
+    DecPoint = t[1];
+    if ( FLT_RADIX != 2 || FLT_MANT_DIG != 24 || DBL_MANT_DIG != 53 ||
+         sizeof(float) != sizeof(uint32_t) ) FastFormat = 0;
+}
+
+//=============================================================================
+
+char* putTime(char *s, int hrs, int mins)
+/*
+**  Purpose:
+**    writes the time of a table line, the same characters as
+**    sprintf(s, "%4d:%02d", hrs, mins), and returns the end of the string.
+*/
+{
+    char t[16];
+    int  i = sizeof(t);
+    int  n, len;
+
+    if ( hrs < 0 || hrs > 999999999 || mins < 0 || mins > 99 )
+        return s + sprintf(s, "%4d:%02d", hrs, mins);
+    do { t[--i] = (char)('0' + hrs % 10); hrs /= 10; } while ( hrs > 0 );
+    len = (int)sizeof(t) - i;
+    for (n = len; n < 4; n++) *s++ = ' ';
+    memcpy(s, t + i, len);
+    s += len;
+    *s++ = ':';
+    *s++ = (char)('0' + mins / 10);
+    *s++ = (char)('0' + mins % 10);
+    *s = '\0';
+    return s;
+}
+
+//=============================================================================
+
+char* putValue(char *s, float c, int prec)
+/*
+**  Purpose:
+**    writes a result of a table line, the same characters as
+**    sprintf(s, "  %10.*f", prec, c), and returns the end of the string.
+**
+**  Notes:
+**    c is a float, so |c| * 10^prec (prec <= 6) is a product of at most 24
+**    and 14 significant bits, which a double holds exactly. The result is
+**    that number rounded to the nearest integer, which is what the C library
+**    gives for the exact value of c, except when the value is exactly half
+**    way between two integers (the library's tie rule is its own). Those,
+**    values of 1.0e9 or more, NaN and infinity are left to sprintf.
+*/
+{
+    char     t[32];
+    double   x, y;
+    uint64_t u;
+    uint32_t bits;
+    int      i, n, len, neg;
+
+    x = (double)c;
+    if ( FastFormat && prec >= 0 && prec <= 6 && fabs(x) < 1.0e9 )
+    {
+        memcpy(&bits, &c, sizeof(bits));
+        neg = (int)(bits >> 31);                 // sign, also of -0.0
+        y = fabs(x) * Pow10[prec];
+        u = (uint64_t)y;
+        y -= (double)u;
+        if ( y != 0.5 )
+        {
+            if ( y > 0.5 ) u++;
+            i = (int)sizeof(t);
+            for (n = 0; n < prec; n++)
+            {
+                t[--i] = (char)('0' + (int)(u % 10));
+                u /= 10;
+            }
+            if ( prec > 0 ) t[--i] = DecPoint;
+            do { t[--i] = (char)('0' + (int)(u % 10)); u /= 10; } while ( u > 0 );
+            if ( neg ) t[--i] = '-';
+            len = (int)sizeof(t) - i;
+            *s++ = ' ';
+            *s++ = ' ';
+            for (n = len; n < 10; n++) *s++ = ' ';
+            memcpy(s, t + i, len);
+            s += len;
+            *s = '\0';
+            return s;
+        }
+    }
+    return s + sprintf(s, "  %10.*f", prec, c);
+}
