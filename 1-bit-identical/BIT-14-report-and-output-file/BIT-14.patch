+int MSXout_getQualBlock(int objType, int k, int m, int j1, int n, REAL4 *x)
+/*
+**  Purpose:
+**    retrieves the results for a block of consecutive nodes or links
+**    from the MSX binary output file with a single read.
+**
+**  Input:
+**    objType = NODE or LINK
+**    k = time period index
+**    m = species index
+**    j1 = index of the first node or link of the block
+**    n = number of nodes or links in the block.
+**
+**  Output:
+**    x[0..n-1] = species concentrations of objects j1 to j1+n-1
+**    (the same values MSXout_getNodeQual or MSXout_getLinkQual return).
+**
+**  Returns:
+**    1 if all n values were read, 0 if not (unread values are set to 0).
+*/
+{
+    size_t nread;
+    long bp;
+    if ( objType == NODE )
+    {
+        bp = ResultsOffset + k * (NodeBytesPerPeriod + LinkBytesPerPeriod);
+        bp += ((m-1)*MSX.Nobjects[NODE] + (j1-1)) * sizeof(REAL4);
+    }
+    else
+    {
+        bp = ResultsOffset + ((k+1)*NodeBytesPerPeriod) + (k*LinkBytesPerPeriod);
+        bp += ((m-1)*MSX.Nobjects[LINK] + (j1-1)) * sizeof(REAL4);
+    }
+    fseek(MSX.OutFile.file, bp, SEEK_SET);
+    nread = fread(x, sizeof(REAL4), n, MSX.OutFile.file);
+    if ( nread < (size_t)n )
+    {
+        memset(x + nread, 0, (n - nread) * sizeof(REAL4));
+        return 0;
+    }
+    return 1;
+}
