+int joinExprs(ChemExprs *ce, int forPipes)
+/*
+**  Purpose:
+**    makes the programs that compute each group of compiled expressions
+**    (and, for pipes, their invariants) in one go.
+**
+**  Input:
+**    ce = compiled expressions
+**    forPipes = 1 for pipe chemistry, 0 for tank chemistry.
+**
+**  Returns:
+**    an error code or 0 if no error.
+**
+**  Note:
+**    a group whose program cannot be made is computed one expression
+**    at a time (see runGroup).
+*/
+{
+    int i, n;
+    int *dest;
+    char *raw;
+    MathExpr **exprs;
+
+    if ( forPipes )
+    {
+        ce->rateProg = joinGroup(ce, ce->rateDeps, ce->nRateDeps,
+                                 PipeRateSpecies, NumPipeRateSpecies);
+        ce->equilProg = joinGroup(ce, ce->equilDeps, ce->nEquilDeps,
+                                  PipeEquilSpecies, NumPipeEquilSpecies);
+    }
+    else
+    {
+        ce->rateProg = joinGroup(ce, ce->rateDeps, ce->nRateDeps,
+                                 TankRateSpecies, NumTankRateSpecies);
+        ce->equilProg = joinGroup(ce, ce->equilDeps, ce->nEquilDeps,
+                                  TankEquilSpecies, NumTankEquilSpecies);
+    }
+    ce->formulaProg = joinGroup(ce, ce->formulaDeps, ce->nFormulaDeps,
+                                NULL, 0);
+    if ( !forPipes || NumInvDeps + NumInvParts == 0 ) return 0;
+
+// --- program computing the invariants of a pipe
+
+    n = NumInvDeps + NumInvParts;
+    exprs = (MathExpr **)calloc(n, sizeof(MathExpr *));
+    dest = (int *)calloc(n, sizeof(int));
+    raw = (char *)calloc(n, sizeof(char));
+    if ( exprs && dest && raw )
+    {
+        for (i = 0; i < NumInvDeps; i++)
+        {
+            exprs[i] = ce->slotExpr[InvDeps[i]];
+            dest[i] = InvDeps[i];
+        }
+        for (i = 0; i < NumInvParts; i++)
+        {
+            exprs[NumInvDeps + i] = InvParts[i];
+            dest[NumInvDeps + i] = InvBase + i;
+            raw[NumInvDeps + i] = 1;
+        }
+        InvProg = mathexpr_join(n, exprs, dest, raw);
+    }
+    FREE(exprs);
+    FREE(dest);
+    FREE(raw);
+    return 0;
+}
+
+//=============================================================================
+
+MathExpr* joinGroup(ChemExprs *ce, int *deps, int nDeps, int *species, int n)
+/*
+**  Purpose:
+**    makes the program that computes a group of compiled expressions.
+**
+**  Input:
+**    ce = compiled expressions
+**    deps = positions of the terms & formulas the group needs
+**    nDeps = number of them
+**    species = species whose expressions are in the group (species[1..n])
+**    n = number of species.
+**
+**  Returns:
+**    the program (NULL if it cannot be made).
+*/
+{
+    int i, count = nDeps + n;
+    int *dest;
+    char *raw;
+    MathExpr **exprs;
+    MathExpr *prog = NULL;
+
+    exprs = (MathExpr **)calloc(count + 1, sizeof(MathExpr *));
+    dest = (int *)calloc(count + 1, sizeof(int));
+    raw = (char *)calloc(count + 1, sizeof(char));
+    if ( exprs && dest && raw )
+    {
+        for (i = 0; i < nDeps; i++)
+        {
+            exprs[i] = ce->slotExpr[deps[i]];
+            dest[i] = deps[i];
+        }
+        for (i = 1; i <= n; i++)
+        {
+            exprs[nDeps + i - 1] = ce->speciesExpr[species[i]];
+            dest[nDeps + i - 1] = OutBase + i;
