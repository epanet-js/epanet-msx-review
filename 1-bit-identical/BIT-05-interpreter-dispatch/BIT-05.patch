+void mathexpr_fuse(MathExpr* expr)
+/*
+**  Purpose:
+**    merges each number or variable that is the second operand of an
+**    arithmetic operator or of ^ into the operator (which then takes it
+**    straight from the expression rather than from the evaluation stack).
+**
+**  Input:
+**    expr = a tokenized expression (changed in place).
+**
+**  Note:
+**    the operations carried out stay the same; an expression processed
+**    this way can only be evaluated by mathexpr_evalVector or by
+**    mathexpr_evalPart, and can no longer be split by mathexpr_split.
+*/
+{
+    int i, j = 0, op;
+    if (expr == NULL || expr->maxDepth < 0 ||
+        expr->maxDepth >= FAST_STACK_SIZE) return;
+    for (i = 0; i < expr->count; i++)
+    {
+        expr->node[j] = expr->node[i];
+        if ((expr->node[i].opcode == 7 || expr->node[i].opcode == 8) &&
+            i + 1 < expr->count)
+        {
+            op = expr->node[i+1].opcode;
+            if (op >= 3 && op <= 6) op = op - 2;
+            else if (op == 31) op = 5;
+            else op = 0;
+            if (op > 0)
+            {
+                if (expr->node[i].opcode == 8) expr->node[j].opcode = 40 + op;
+                else                           expr->node[j].opcode = 50 + op;
+                i++;
+            }
+        }
+        j++;
+    }
+    setCount(expr, j);
+}
+
+//=============================================================================
+
+MathExpr* mathexpr_join(int n, MathExpr** exprs, const int* dest,
+                        const char* raw)
+/*
+**  Purpose:
+**    makes a program that evaluates a list of expressions in turn and
+**    stores the value of each as the value of a variable.
+**
+**  Input:
+**    n = number of expressions
+**    exprs = the expressions (a NULL one has the value 0)
+**    dest = index of the variable that receives each expression's value
+**    raw = 0 if an expression's value is taken as mathexpr_evalVector
+**          returns it (a NaN as 0), 1 if as mathexpr_evalPart does.
+**
+**  Returns:
+**    the program, to be run by mathexpr_run (NULL if out of memory or
+**    if one of the expressions is not suited to it).
+**
+**  Note:
+**    each expression is evaluated by the same operations as when it is
+**    evaluated on its own, so the values stored are the same.
+*/
+{
+    int i, count = 0, maxDepth = 1;
+    MathExpr* prog;
+    ExprNode* node;
+
+    for (i = 0; i < n; i++)
+    {
+        if (exprs[i] == NULL)
+        {
+            count += 2;
+            continue;
+        }
+        if (exprs[i]->maxDepth < 0 || exprs[i]->maxDepth >= FAST_STACK_SIZE)
+            return NULL;
+        if (exprs[i]->maxDepth > maxDepth) maxDepth = exprs[i]->maxDepth;
+        count += exprs[i]->count + 1;
+    }
+    prog = newExpr(count);
+    if (prog == NULL) return NULL;
+    prog->maxDepth = maxDepth;
+    node = prog->node;
+    for (i = 0; i < n; i++)
+    {
+        if (exprs[i] == NULL)
+        {
+            node->opcode = 7;
+            node->ivar = -1;
+            node->fvalue = 0.0;
+            node++;
+        }
+        else
+        {
+            memcpy(node, exprs[i]->node, exprs[i]->count * sizeof(ExprNode));
+            node += exprs[i]->count;
+        }
+        node->opcode = raw[i] ? 61 : 60;
+        node->ivar = dest[i];
+        node->fvalue = 0.0;
+        node++;
+    }
+    return prog;
+}
