+//=============================================================================
+//  Rewriting an expression so that it takes fewer operations
+//=============================================================================
+
+//  Node of the tree form of an expression being rewritten (nodes are never
+//  changed once they are in use, so they can be shared by several trees)
+typedef struct SNode SNode;
+struct SNode
+{
+    int    opcode;                // operator code (as in ExprNode)
+    int    ivar;                  // variable index
+    double fvalue;                // numerical value
+    SNode* left;                  // first (or only) operand
+    SNode* right;                 // second operand
+    char   fixed;                 // 1 if the value depends only on numbers
+                                  // and on fixed variables
+    int    cost;                  // operations it takes (0 = not known yet)
+    SNode* pos;                   // cheapest tree with the same value
+    SNode* neg;                   // cheapest tree with the opposite value
+};
+
+typedef struct
+{
+    jmp_buf     fail;             // where to go when out of room
+    SNode*      node;             // room for nodes
+    int         nNodes, maxNodes;
+    const char* isFixed;          // flags of the fixed variables
+} Simplifier;
+
+static SNode* rewrite(Simplifier* s, SNode* t);
+
+//=============================================================================
+
+static int isArith(int opcode)
+//  1 for the operators that rewrite works through: + - * / and negation
+{
+    return (opcode >= 3 && opcode <= 6) || opcode == 9;
+}
+
+//=============================================================================
+
+static int isLeafLike(SNode* t)
+//  1 if t takes a single operation, or none as the second operand of an
+//  operator, once fixed parts are split off and operands are fused
+{
+    return t->fixed || t->opcode == 7 || t->opcode == 8;
+}
+
+//=============================================================================
+
+static SNode* snode(Simplifier* s, int opcode, SNode* left, SNode* right)
+{
+    SNode* t;
+    if (s->nNodes >= s->maxNodes) longjmp(s->fail, 1);
+    t = &s->node[s->nNodes++];
+    memset(t, 0, sizeof(SNode));
+    t->opcode = opcode;
+    t->ivar = -1;
+    t->left = left;
+    t->right = right;
+    t->pos = NULL;
+    t->neg = NULL;
+    if (left) t->fixed = left->fixed && (right == NULL || right->fixed);
+    return t;
+}
+
+//=============================================================================
+
+static SNode* snumber(Simplifier* s, double x)
+{
+    SNode* t = snode(s, 7, NULL, NULL);
+    t->fvalue = x;
+    t->fixed = 1;
+    return t;
+}
+
+//=============================================================================
+
+static int scost(SNode* t)
+//  number of operations taken by a tree
+{
+    int c;
+    if (t->cost > 0) return t->cost;
+    if (isLeafLike(t)) c = 1;
+    else if (t->right == NULL) c = scost(t->left) + 1;
+    else if (isLeafLike(t->right)) c = scost(t->left) + 1;
+    else c = scost(t->left) + scost(t->right) + 1;
+    t->cost = c;
+    return c;
+}
+
+//=============================================================================
+
+static SNode* cheaper(SNode* a, SNode* b)
+//  the tree that takes fewer operations (a if they take as many)
+{
+    return scost(b) < scost(a) ? b : a;
+}
