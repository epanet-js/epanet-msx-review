+            r = cheaper(r, snode(s, 5, na, pb));
+            r = cheaper(r, snode(s, 5, pb, na));
+            r = cheaper(r, snode(s, 5, pa, nb));
+            r = cheaper(r, snode(s, 5, nb, pa));
+            break;
+        case 6:
+            r = cheaper(r, snode(s, 6, na, pb));
+            r = cheaper(r, snode(s, 6, pa, nb));
+            break;
+        }
+    }
+    r->pos = r;
+    t->neg = r;
+    return r;
+}
+
+//=============================================================================
+
+static SNode* spos(Simplifier* s, SNode* t)
+//  the cheapest tree found whose value is t's, bit for bit: operands of
+//  + and * swapped, and signs moved, so that more operands can be fused
+//  into their operators and more negations become part of fixed parts
+{
+    SNode *r, *pa, *pb, *na, *nb;
+    if (t->pos) return t->pos;
+    if (isLeafLike(t) || !isArith(t->opcode)) r = t;
+    else if (t->opcode == 9) r = sneg(s, t->left);
+    else
+    {
+        pa = spos(s, t->left);
+        pb = spos(s, t->right);
+        na = sneg(s, t->left);
+        nb = sneg(s, t->right);
+        r = snode(s, t->opcode, pa, pb);
+        switch (t->opcode)
+        {
+        case 3:
+            r = cheaper(r, snode(s, 3, pb, pa));
+            r = cheaper(r, snode(s, 4, pa, nb));
+            r = cheaper(r, snode(s, 4, pb, na));
+            break;
+        case 4:
+            r = cheaper(r, snode(s, 3, pa, nb));
+            r = cheaper(r, snode(s, 3, nb, pa));
+            r = cheaper(r, snode(s, 4, nb, na));
+            break;
+        case 5:
+            r = cheaper(r, snode(s, 5, pb, pa));
+            r = cheaper(r, snode(s, 5, na, nb));
+            r = cheaper(r, snode(s, 5, nb, na));
+            break;
+        case 6:
+            r = cheaper(r, snode(s, 6, na, nb));
+            break;
+        }
+    }
+    r->pos = r;
+    t->pos = r;
+    return r;
+}
+
+//=============================================================================
+
+static void rewriteOperands(Simplifier* s, SNode* t)
+//  rewrites the operands of the functions and powers within a tree
+//  of arithmetic operators
+{
+    if (t->left)
+    {
+        if (!t->left->fixed && isArith(t->left->opcode))
+            rewriteOperands(s, t->left);
+        else t->left = rewrite(s, t->left);
+    }
+    if (t->right)
+    {
+        if (!t->right->fixed && isArith(t->right->opcode))
+            rewriteOperands(s, t->right);
+        else t->right = rewrite(s, t->right);
+    }
+}
+
+//=============================================================================
+
+static SNode* rewrite(Simplifier* s, SNode* t)
+//  the cheapest form found of a tree
+{
+    if (t->fixed) return t;
+    if (!isArith(t->opcode))
+    {
+        if (t->left) t->left = rewrite(s, t->left);
+        if (t->right) t->right = rewrite(s, t->right);
+        return t;
+    }
+    rewriteOperands(s, t);
+    return spos(s, t);
+}
+
+//=============================================================================
+
+static SNode* stree(Simplifier* s, MathExpr* expr, SNode** stack)
+//  tree form of an expression
+{
+    int i, sp = 0;
+    ExprNode* e;
+    SNode* t;
+    for (i = 0; i < expr->count; i++)
+    {
+        e = &expr->node[i];
+        switch (e->opcode)
+        {
+        case 7:
+            t = snumber(s, e->fvalue);
+            break;
+        case 8:
+            t = snode(s, 8, NULL, NULL);
+            t->ivar = e->ivar;
+            t->fixed = (s->isFixed[e->ivar] != 0);
+            break;
+        case 3: case 4: case 5: case 6: case 31:
+            sp -= 2;
+            t = snode(s, e->opcode, stack[sp], stack[sp+1]);
+            break;
+        default:
+            sp--;
+            t = snode(s, e->opcode, stack[sp], NULL);
+        }
+        stack[sp++] = t;
+    }
+    return stack[0];
+}
+
+//=============================================================================
+
+static int scount(SNode* t)
+{
+    return 1 + (t->left ? scount(t->left) : 0) + (t->right ? scount(t->right) : 0);
+}
+
+//=============================================================================
+
+static void spostfix(SNode* t, ExprNode** node)
+{
+    if (t->left) spostfix(t->left, node);
+    if (t->right) spostfix(t->right, node);
+    (*node)->opcode = t->opcode;
+    (*node)->ivar = t->ivar;
+    (*node)->fvalue = t->fvalue;
+    (*node)++;
+}
+
+//=============================================================================
+
+MathExpr* mathexpr_simplify(MathExpr* expr, const char* isFixed)
+/*
+**  Purpose:
+**    rewrites an expression so that it takes fewer operations to evaluate
+**    once its parts with fixed values are split off (see mathexpr_split)
+**    and its numbers and variables are fused into operators (see
+**    mathexpr_fuse), keeping its value bit for bit: the operands of + and
+**    * are swapped and signs moved (a+(-b) = a-b, (-a)*b = -(a*b), ...)
+**    so that more numbers and variables are second operands and more
+**    negations become part of fixed parts.
+**
+**  Input:
+**    expr = a tokenized expression (not fused)
+**    isFixed = flags of the variables whose values are fixed.
+**
+**  Returns:
+**    the rewritten expression, or NULL if no cheaper form was found (or
+**    out of memory).
+*/
+{
+    Simplifier s;
+    SNode** stack = NULL;
+    SNode *orig, *t;
+    MathExpr* result = NULL;
+    ExprNode* node;
+    int i, n;
+
+    if (expr == NULL || expr->maxDepth < 1 ||
+        expr->maxDepth >= FAST_STACK_SIZE) return NULL;
+    for (i = 0; i < expr->count; i++)
+    {
+        if (expr->node[i].opcode > 31) return NULL;
+    }
+    n = expr->count;
+    memset(&s, 0, sizeof(Simplifier));
+    s.isFixed = isFixed;
+    s.maxNodes = 16 * n + 64;
+    s.node = (SNode*)malloc(s.maxNodes * sizeof(SNode));
+    stack = (SNode**)malloc(n * sizeof(SNode*));
+    if (s.node == NULL || stack == NULL) ;
+    else if (setjmp(s.fail) == 0)
+    {
+        orig = stree(&s, expr, stack);
+        t = rewrite(&s, stree(&s, expr, stack));
+        if (scost(t) < scost(orig))
+        {
+            n = scount(t);
+            result = newExpr(n);
+            if (result)
+            {
+                node = result->node;
+                spostfix(t, &node);
+                result->maxDepth = getMaxDepth(result);
+                if (result->maxDepth < 0 || result->maxDepth >= FAST_STACK_SIZE)
+                {
+                    free(result);
+                    result = NULL;
+                }
+            }
+        }
+    }
+    free(s.node);
+    free(stack);
+    return result;
+}
