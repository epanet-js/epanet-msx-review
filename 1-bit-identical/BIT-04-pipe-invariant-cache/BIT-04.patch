+int mathexpr_split(MathExpr* expr, const char* isFixed, int firstVar,
+                   MathExpr** parts)
+/*
+**  Purpose:
+**    replaces each largest part of an expression (of two or more nodes)
+**    whose value depends only on numbers and on variables i for which
+**    isFixed[i] is nonzero by a new variable (firstVar, firstVar+1, ...)
+**    and makes each part an expression of its own.
+**
+**  Input:
+**    expr = a tokenized expression (changed in place)
+**    isFixed = flags of the variables whose values are fixed
+**    firstVar = index given to the variable that replaces the first part
+**    parts = array that receives the parts (with room for at least
+**            expr->count / 2 of them).
+**
+**  Returns:
+**    the number of parts (or -1 if out of memory).
+**
+**  Note:
+**    the expression keeps its value when the new variables are given
+**    the values of the parts as computed by mathexpr_evalPart, since
+**    the same operations are carried out on the same numbers.
+*/
+{
+    int i, j, r, left, n, nparts = 0;
+    int *start, *parent, *splitAt;
+    char *fixed;
+
+    if (expr == NULL || expr->maxDepth < 0) return 0;
+    n = expr->count;
+    start = (int*)malloc(n * sizeof(int));
+    parent = (int*)malloc(n * sizeof(int));
+    splitAt = (int*)malloc(n * sizeof(int));
+    fixed = (char*)malloc(n * sizeof(char));
+    if (!start || !parent || !splitAt || !fixed)
+    {
+        nparts = -1;
+        goto done;
+    }
+
+    // --- find the first node of the sub-tree rooted at each node, its
+    //     parent node and whether its value is fixed (in postfix order the
+    //     root of an operator's last operand comes just before it and the
+    //     root of the operand before that just before the first node of
+    //     the last operand)
+
+    for (i = 0; i < n; i++)
+    {
+        parent[i] = -1;
+        splitAt[i] = -1;
+        switch (expr->node[i].opcode)
+        {
+        case 7:
+            start[i] = i;
+            fixed[i] = 1;
+            break;
+        case 8:
+            start[i] = i;
+            fixed[i] = (isFixed[expr->node[i].ivar] != 0);
+            break;
+        case 3: case 4: case 5: case 6: case 31:
+            left = start[i-1] - 1;
+            start[i] = start[left];
+            fixed[i] = fixed[left] && fixed[i-1];
+            parent[left] = i;
+            parent[i-1] = i;
+            break;
+        default:
+            start[i] = start[i-1];
+            fixed[i] = fixed[i-1];
+            parent[i-1] = i;
+        }
+    }
+
+    // --- mark the largest fixed sub-trees of two or more nodes
+
+    for (r = 0; r < n; r++)
+    {
+        if (fixed[r] && start[r] < r &&
+            (parent[r] < 0 || !fixed[parent[r]])) splitAt[start[r]] = r;
+    }
+
+    // --- move each one to an expression of its own
+
+    j = 0;
+    i = 0;
+    while (i < n)
+    {
+        r = splitAt[i];
+        if (r < 0)
+        {
+            expr->node[j++] = expr->node[i++];
+            continue;
+        }
+        parts[nparts] = (MathExpr*)malloc(sizeof(MathExpr) +
+                                          (r - i + 1) * sizeof(ExprNode));
+        if (parts[nparts] == NULL)
+        {
+            while (nparts > 0) free(parts[--nparts]);
+            nparts = -1;
+            goto done;
+        }
+        parts[nparts]->count = r - i + 1;
+        parts[nparts]->node = (ExprNode*)(parts[nparts] + 1);
+        memcpy(parts[nparts]->node, &expr->node[i],
+               (r - i + 1) * sizeof(ExprNode));
+        parts[nparts]->maxDepth = getMaxDepth(parts[nparts]);
+        expr->node[j].opcode = 8;
+        expr->node[j].ivar = firstVar + nparts;
+        expr->node[j].fvalue = 0.0;
+        j++;
+        nparts++;
+        i = r + 1;
+    }
+    expr->count = j;
+    expr->maxDepth = getMaxDepth(expr);
+
+done:
+    free(start);
+    free(parent);
+    free(splitAt);
+    free(fixed);
+    return nparts;
+}
