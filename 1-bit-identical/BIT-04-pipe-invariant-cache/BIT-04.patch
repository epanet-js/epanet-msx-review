+//=============================================================================
+
+int splitInvariants(ChemExprs *ce)
+/*
+**  Purpose:
+**    finds the pipe terms and formula species whose values are invariant
+**    within a pipe and splits the invariant parts off the other pipe
+**    expressions.
+**
+**  Input:
+**    ce = compiled pipe chemistry expressions.
+**
+**  Output:
+**    ce = expressions without their invariant parts.
+**
+**  Returns:
+**    an error code or 0 if no error.
+*/
+{
+    int i, j, m, n, type, nAll = 0, maxParts = 0, errcode = 0;
+    int *all;
+    char *isFixed;
+    MathExpr *expr;
+
+    all = (int *)calloc(NumValues, sizeof(int));
+    isFixed = (char *)calloc(NumValues, sizeof(char));
+    InvDeps = (int *)calloc(NumValues, sizeof(int));
+    if ( !all || !isFixed || !InvDeps )
+    {
+        errcode = ERR_MEMORY;
+        goto done;
+    }
+
+// --- parameters, constants & hydraulic variables are fixed within a pipe
+//     (as is position 0, which always holds 0)
+
+    isFixed[0] = 1;
+    for (i = LastIndex[TERM] + 1; i <= FormBase; i++) isFixed[i] = 1;
+
+// --- list the terms & formula species used by pipe expressions in order
+//     of dependency (merging the lists of each type of expression)
+
+    for (j = 0; j < ce->nRateDeps; j++)
+        if ( !isFixed[ce->rateDeps[j]] ) isFixed[all[nAll++] = ce->rateDeps[j]] = 2;
+    for (j = 0; j < ce->nEquilDeps; j++)
+        if ( !isFixed[ce->equilDeps[j]] ) isFixed[all[nAll++] = ce->equilDeps[j]] = 2;
+    for (j = 0; j < ce->nFormulaDeps; j++)
+        if ( !isFixed[ce->formulaDeps[j]] ) isFixed[all[nAll++] = ce->formulaDeps[j]] = 2;
+    for (j = 0; j < nAll; j++) isFixed[all[j]] = 0;
+
+// --- a term or formula is invariant if all of its variables are
+
+    for (j = 0; j < nAll; j++)
+    {
+        expr = ce->slotExpr[all[j]];
+        isFixed[all[j]] = 1;
+        if ( expr == NULL ) continue;
+        for (i = 0; i < expr->count; i++)
+        {
+            if ( expr->node[i].opcode == 8 && !isFixed[expr->node[i].ivar] )
+            {
+                isFixed[all[j]] = 0;
+                break;
+            }
+        }
+        if ( isFixed[all[j]] ) InvDeps[NumInvDeps++] = all[j];
+    }
+
+// --- invariant terms & formulas are taken off the lists of values
+//     computed for each type of expression
+
+    ce->nRateDeps = filterDeps(ce->rateDeps, ce->nRateDeps, isFixed);
+    ce->nEquilDeps = filterDeps(ce->equilDeps, ce->nEquilDeps, isFixed);
+    ce->nFormulaDeps = filterDeps(ce->formulaDeps, ce->nFormulaDeps, isFixed);
+
+// --- split the invariant parts off the other terms & formulas and off
+//     the rate & equilibrium expressions
+
+    for (j = 0; j < nAll; j++)
+        if ( !isFixed[all[j]] && ce->slotExpr[all[j]] )
+            maxParts += ce->slotExpr[all[j]]->count / 2;
+    for (m = 1; m <= NumSpecies; m++)
+        if ( ce->speciesExpr[m] ) maxParts += ce->speciesExpr[m]->count / 2;
+    InvParts = (MathExpr **)calloc(maxParts + 1, sizeof(MathExpr *));
+    if ( !InvParts )
+    {
+        errcode = ERR_MEMORY;
+        goto done;
+    }
+    InvBase = NumValues;
+    for (j = 0; j < nAll && !errcode; j++)
+    {
+        if ( isFixed[all[j]] ) continue;
+        n = mathexpr_split(ce->slotExpr[all[j]], isFixed,
+                           InvBase + NumInvParts, InvParts + NumInvParts);
+        if ( n < 0 ) errcode = ERR_MEMORY;
+        else NumInvParts += n;
+    }
+    for (m = 1; m <= NumSpecies && !errcode; m++)
+    {
+        type = MSX.Species[m].pipeExprType;
+        if ( type != RATE && type != EQUIL ) continue;
+        n = mathexpr_split(ce->speciesExpr[m], isFixed,
+                           InvBase + NumInvParts, InvParts + NumInvParts);
+        if ( n < 0 ) errcode = ERR_MEMORY;
+        else NumInvParts += n;
+    }
+    if ( errcode ) goto done;
+    NumValues += NumInvParts;
+
+// --- cache of the values of the invariants of each link
+
+    if ( NumInvDeps + NumInvParts > 0 )
+    {
+        NumInvInputs = FormBase - LastIndex[TERM];
+        InvStride = NumInvDeps + NumInvParts + NumInvInputs;
+        InvCache = (double *)calloc((size_t)(MSX.Nobjects[LINK] + 1) * InvStride,
+                                    sizeof(double));
+        InvValid = (char *)calloc(MSX.Nobjects[LINK] + 1, sizeof(char));
+        if ( !InvCache || !InvValid ) errcode = ERR_MEMORY;
+    }
+
+done:
+    FREE(all);
+    FREE(isFixed);
+    return errcode;
+}
+
+//=============================================================================
+
+int filterDeps(int *list, int n, char *isFixed)
+/*
+**  Purpose:
+**    removes the invariant terms & formulas from a list of them.
+**
+**  Input:
+**    list = positions of terms & formula species
+**    n = number of items in list
+**    isFixed = 1 for those that are invariant.
+**
+**  Returns:
+**    the new number of items in the list.
+*/
+{
+    int j, k = 0;
+    for (j = 0; j < n; j++)
+    {
+        if ( !isFixed[list[j]] ) list[k++] = list[j];
+    }
+    return k;
+}
+
+//=============================================================================
+
+void setPipeInvariants(ChemState *cs, int k)
+/*
+**  Purpose:
+**    places the values of the invariant terms, formulas and parts of
+**    pipe k in the vector of variable values, taking them from the cache
+**    if they were computed from the same inputs.
+**
+**  Input:
+**    cs = the thread's chemistry state (with the parameters, constants
+**         and hydraulic variables of pipe k already in place)
+**    k = link index.
+*/
+{
+    int i;
+    double *val = cs->ChemC1;
+    double *in = val + LastIndex[TERM] + 1;
+    double *cache = InvCache + (size_t)k * InvStride;
+    double *inputs = cache + NumInvDeps + NumInvParts;
+
+    if ( InvValid[k] &&
+         memcmp(inputs, in, NumInvInputs * sizeof(double)) == 0 )
+    {
+        for (i = 0; i < NumInvDeps; i++) val[InvDeps[i]] = cache[i];
+        for (i = 0; i < NumInvParts; i++)
+            val[InvBase + i] = cache[NumInvDeps + i];
+        return;
+    }
+    evalDeps(PipeExprs.slotExpr, InvDeps, NumInvDeps, val);
+    for (i = 0; i < NumInvParts; i++)
+        val[InvBase + i] = mathexpr_evalPart(InvParts[i], val);
+    for (i = 0; i < NumInvDeps; i++) cache[i] = val[InvDeps[i]];
+    for (i = 0; i < NumInvParts; i++)
+        cache[NumInvDeps + i] = val[InvBase + i];
+    memcpy(inputs, in, NumInvInputs * sizeof(double));
+    InvValid[k] = 1;
+}
