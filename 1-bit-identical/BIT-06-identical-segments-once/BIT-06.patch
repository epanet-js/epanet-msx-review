+int isSameWater(Pseg seg1, Pseg seg2)
+/*
+**  Purpose:
+**    checks if two segments of a pipe hold the same water.
+**
+**  Input:
+**    seg1, seg2 = two segments.
+**
+**  Returns:
+**    1 if their concentrations and integration time steps are the
+**    same, bit for bit, or 0 if not.
+*/
+{
+    int m;
+    uint64_t x, y;
+
+    memcpy(&x, &seg1->hstep, sizeof(x));
+    memcpy(&y, &seg2->hstep, sizeof(y));
+    if ( x != y ) return 0;
+    for (m = 1; m <= NumSpecies; m++)
+    {
+        memcpy(&x, &seg1->c[m], sizeof(x));
+        memcpy(&y, &seg2->c[m], sizeof(y));
+        if ( x != y ) return 0;
+    }
+    return 1;
+}
+
+//=============================================================================
+
+void copyPipeReactions(int k, Pseg src, Pseg seg)
+/*
+**  Purpose:
+**    gives a pipe segment the results of reactions over the current time
+**    step of another segment of the pipe that held the same water.
+**
+**  Input:
+**    k = link index
+**    src = the segment of pipe k already reacted (its lastc[] holds its
+**          concentrations after the reactions, and c[] those after the
+**          equilibria and formulas that followed)
+**    seg = a segment of pipe k that held the same water as src before.
+**
+**  Output:
+**    updates seg's concentrations and integration time step as
+**    evalPipeReactions would have, and the mass reacted in pipe k.
+*/
+{
+    int m;
+    for (m = 1; m <= NumSpecies; m++)
+    {
+        seg->lastc[m] = seg->c[m];
+        seg->c[m] = src->lastc[m];
+    }
+    seg->hstep = src->hstep;
+    addPipeReactedMass(k, seg);
+    if ( NumPipeEquilSpecies + NumPipeFormulaSpecies > 0 )
+    {
+        for (m = 1; m <= NumSpecies; m++) seg->c[m] = src->c[m];
+    }
+}
+
+//=============================================================================
+
+void addPipeReactedMass(int k, Pseg seg)
+/*
+**  Purpose:
+**    adds the mass of each species reacted in a pipe segment over the
+**    current time step to the pipe's total.
+**
+**  Input:
+**    k = link index
+**    seg = the segment, with its concentrations before the reactions
+**          in lastc[] and after them in c[].
+**
+**  Output:
+**    updates MSX.Link[k].reacted[] and sets seg->lastc[] to seg->c[].
+*/
+{
+    int m;
+    for (m = 1; m <= MSX.Nobjects[SPECIES]; m++)
+    {
+        if (MSX.Species[m].type == BULK)
+        {
+            MSX.Link[k].reacted[m] += seg->v * (seg->c[m] - seg->lastc[m]) * LperFT3;
+        }
+        else if (MSX.Link[k].diam > 0)
+        {
+            MSX.Link[k].reacted[m] += seg->v * 4.0 / MSX.Link[k].diam * MSX.Ucf[AREA_UNITS] * (seg->c[m] - seg->lastc[m]);
+        }
+        seg->lastc[m] = seg->c[m];
+    }
+}
+
