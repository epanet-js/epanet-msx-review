+static void freelinkseg()
+{
+	int k;
+	if (linkseg)
+		for (k = 0; k <= linksegN; k++)
+			FREE(linkseg[k]);
+	FREE(linkseg);
+	FREE(linksegn);
+	FREE(linksegcap);
+	linksegN = 0;
+}
+
+static Pseg* growlinkseg(int k, int n)
+// makes room for segments 1..n+1 in linkseg[k]
+{
+	int cap = 2 * linksegcap[k];
+	Pseg* p;
+	if (cap < n + 2)
+		cap = n + 2;
+	if (cap < 32)
+		cap = 32;
+	p = (Pseg*)realloc(linkseg[k], cap * sizeof(Pseg));
+	if (p == NULL)
+	{
+		MSX.OutOfMemory = TRUE;
+		return NULL;
+	}
+	linkseg[k] = p;
+	linksegcap[k] = cap;
+	return p;
+}
