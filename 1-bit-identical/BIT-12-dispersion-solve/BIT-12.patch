+// Solve a pipe's tri-diagonal system of eqns. for three right-hand sides at once:
+// r (solution y1), the unit vector at the first (downstream) end (y2) and the
+// unit vector at the last (upstream) end (y3), and store the solutions of rows
+// 1..n-2 in the pipe's segments seg[1..n-2] (hresponse, dresponse, uresponse).
+// The forward elimination (gam, bet) is done once for all three and each solution
+// gets exactly the same floating point operations as a separate call of tridiag()
+// would give it.
+
+static void tridiag3(int n, double *a, double *b, double *c, double *r, Pseg *seg)
+{
+	int j;
+	double bet, r3;
+	double *y1 = sol, *y2 = sold, *y3 = solu;
+	double z1, z2, z3;
+
+	bet = b[0];
+	y1[0] = r[0] / bet;
+	y2[0] = 1.0 / bet;
+	y3[0] = 0.0 / bet;
+	for (j = 1; j < n; j++)
+	{
+		gam[j] = c[j - 1] / bet;
+		bet = b[j] - a[j] * gam[j];
+		r3 = (j == n - 1) ? 1.0 : 0.0;
+		y1[j] = (r[j] - a[j] * y1[j - 1]) / bet;
+		y2[j] = (0.0 - a[j] * y2[j - 1]) / bet;
+		y3[j] = (r3 - a[j] * y3[j - 1]) / bet;
+	}
+
+	// --- back substitution, from the upstream end (row n-1) to row 1
+	//     (row 0, the downstream boundary, is not needed)
+	z1 = y1[n - 1];
+	z2 = y2[n - 1];
+	z3 = y3[n - 1];
+	for (j = n - 2; j >= 1; j--)
+	{
+		z1 = y1[j] - gam[j + 1] * z1;
+		z2 = y2[j] - gam[j + 1] * z2;
+		z3 = y3[j] - gam[j + 1] * z3;
+		seg[j]->hresponse = z1;
+		seg[j]->dresponse = z2;
+		seg[j]->uresponse = z3;
+	}
+}
