+MathExpr* mathexpr_copy(MathExpr* expr)
+//  Returns a copy of an expression (NULL if expr is NULL or out of memory)
+{
+    MathExpr* copy;
+    size_t size;
+    if (expr == NULL) return NULL;
+    size = sizeof(MathExpr) + expr->count * sizeof(ExprNode);
