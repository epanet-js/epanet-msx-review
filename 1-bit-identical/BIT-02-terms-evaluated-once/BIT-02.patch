+//=============================================================================
+
+double evaluate(MathExpr* expr, double (*getVariableValue) (int),
+                const double* values)
+//  Mathematical expression evaluation using a stack (variable values come
+//  from the values array if it is not NULL or else from getVariableValue)
+{
+    // --- Note: the stack array must be declared locally and not globally
+    //     since this function can be called recursively.
+
+    double stack[FAST_STACK_SIZE];
+    ExprNode* node;
+    ExprNode* end;
+    double top, r1;
+    int sp;
+
+    // --- expressions that are not well formed (or need a very deep
+    //     stack) are evaluated by the general purpose evaluator
+
+    if (expr == NULL) return 0.0;
+    if (expr->maxDepth < 0 || expr->maxDepth >= FAST_STACK_SIZE)
+        return evalGeneric(expr, getVariableValue, values);
+
+    // --- the value on top of the stack is held in top and the values
+    //     beneath it in stack[1..sp]; the operations are the same as
+    //     those of evalGeneric
+
+    top = 0.0;
+    sp = 0;
+    node = expr->node;
+    end = node + expr->count;
+    for (; node < end; node++)
+    {
+        switch (node->opcode)
+        {
+        case 3:  top = stack[sp--] + top;  break;
+        case 4:  top = stack[sp--] - top;  break;
+        case 5:  top = stack[sp--] * top;  break;
+        case 6:  top = stack[sp--] / top;  break;
+
+        case 7:
+            stack[++sp] = top;
+            top = node->fvalue;
+            break;
+
+        case 8:
+            stack[++sp] = top;
+            if (values != NULL)
+                top = values[node->ivar];
+            else if (getVariableValue != NULL)
+                top = getVariableValue(node->ivar);
+            else top = 0.0;
+            break;
+
+        case 9:  top = -top;       break;
+        case 10: top = cos(top);   break;
+        case 11: top = sin(top);   break;
+        case 12: top = tan(top);   break;
+        case 13: top = 1.0 / tan(top);  break;
+        case 14: top = fabs(top);  break;
+
+        case 15:
+            if (top < 0.0) top = -1.0;
+            else if (top > 0.0) top = 1.0;
+            else top = 0.0;
+            break;
+
+        case 16: top = sqrt(top);  break;
+        case 17: top = log(top);   break;
+        case 18: top = exp(top);   break;
+        case 19: top = asin(top);  break;
+        case 20: top = acos(top);  break;
+        case 21: top = atan(top);  break;
+        case 22: top = 1.57079632679489661923 - atan(top);  break;
+
+        case 23:
+            r1 = top;
+            top = (exp(r1) - exp(-r1)) / 2.0;
+            break;
+
+        case 24:
+            r1 = top;
+            top = (exp(r1) + exp(-r1)) / 2.0;
+            break;
+
+        case 25:
+            r1 = top;
+            top = (exp(r1) - exp(-r1)) / (exp(r1) + exp(-r1));
+            break;
+
+        case 26:
+            r1 = top;
+            top = (exp(r1) + exp(-r1)) / (exp(r1) - exp(-r1));
+            break;
+
+        case 27: top = log10(top);  break;
+
+        case 28:
+            if (top <= 0.0) top = 0.0;
+            else            top = 1.0;
+            break;
+
+        case 31:
+            r1 = top;
+            top = stack[sp--];
+            if (top <= 0.0) top = 0.0;
+            else top = pow(top, r1);
+            break;
+        }
+    }
+
+    // Set result to 0 if it is NaN due to an illegal math op
+    if (top != top) top = 0.0;
+    return top;
+}
