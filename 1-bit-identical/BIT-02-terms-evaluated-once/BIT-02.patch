+//=============================================================================
+
+int compileExprs(ChemExprs *ce, int forPipes)
+/*
+**  Purpose:
+**    compiles the chemistry expressions of pipes or of tanks.
+**
+**  Input:
+**    ce = structure that receives the compiled expressions
+**    forPipes = 1 for pipe chemistry, 0 for tank chemistry.
+**
+**  Returns:
+**    an error code or 0 if no error.
+**
+**  Note:
+**    a term or formula species that refers to itself (through other
+**    terms or formula species) is reported as an input error; it would
+**    otherwise send the evaluation of the expressions into an endless
+**    recursion.
+*/
+{
+    int i, m, type;
+    int errcode = 0;
+    char *mark;
+    MathExpr *expr;
+
+    ce->slotExpr = (MathExpr **)calloc(NumValues, sizeof(MathExpr *));
+    ce->speciesExpr = (MathExpr **)calloc(NumSpecies + 1, sizeof(MathExpr *));
+    ce->rateDeps = (int *)calloc(NumValues, sizeof(int));
+    ce->equilDeps = (int *)calloc(NumValues, sizeof(int));
+    ce->formulaDeps = (int *)calloc(NumValues, sizeof(int));
+    mark = (char *)calloc(NumValues, sizeof(char));
+    if ( !ce->slotExpr || !ce->speciesExpr || !ce->rateDeps ||
+         !ce->equilDeps || !ce->formulaDeps || !mark )
+    {
+        FREE(mark);
+        return ERR_MEMORY;
+    }
+
+// --- compile the expressions of intermediate terms
+
+    for (i = 1; i <= MSX.Nobjects[TERM]; i++)
+    {
+        expr = MSX.Term[i].expr;
+        if ( expr == NULL ) continue;
+        ce->slotExpr[LastIndex[SPECIES] + i] = compileExpr(expr, forPipes);
+        if ( ce->slotExpr[LastIndex[SPECIES] + i] == NULL ) errcode = ERR_MEMORY;
+    }
+
+// --- compile the expressions of species
+
+    for (m = 1; m <= NumSpecies; m++)
+    {
+        if ( forPipes ) expr = MSX.Species[m].pipeExpr;
+        else            expr = MSX.Species[m].tankExpr;
+        if ( expr == NULL ) continue;
+        ce->speciesExpr[m] = compileExpr(expr, forPipes);
+        if ( ce->speciesExpr[m] == NULL ) errcode = ERR_MEMORY;
+        if ( forPipes ) type = MSX.Species[m].pipeExprType;
+        else            type = MSX.Species[m].tankExprType;
+        if ( type == FORMULA ) ce->slotExpr[FormBase + m] = ce->speciesExpr[m];
+    }
+    if ( errcode )
+    {
+        FREE(mark);
+        return errcode;
+    }
+
+// --- find the terms and formulas needed by each type of expression
+
+    for (m = 1; m <= NumSpecies && !errcode; m++)
+    {
+        if ( forPipes ) type = MSX.Species[m].pipeExprType;
+        else            type = MSX.Species[m].tankExprType;
+        if ( type == RATE ) errcode = findDeps(ce, ce->speciesExpr[m],
+                                   ce->rateDeps, &ce->nRateDeps, mark);
+    }
+    memset(mark, 0, NumValues);
+    for (m = 1; m <= NumSpecies && !errcode; m++)
+    {
+        if ( forPipes ) type = MSX.Species[m].pipeExprType;
+        else            type = MSX.Species[m].tankExprType;
+        if ( type == EQUIL ) errcode = findDeps(ce, ce->speciesExpr[m],
+                                    ce->equilDeps, &ce->nEquilDeps, mark);
+    }
+    memset(mark, 0, NumValues);
+    for (m = 1; m <= NumSpecies && !errcode; m++)
+    {
+        if ( forPipes ) type = MSX.Species[m].pipeExprType;
+        else            type = MSX.Species[m].tankExprType;
+        if ( type == FORMULA ) errcode = addDep(ce, FormBase + m,
+                                  ce->formulaDeps, &ce->nFormulaDeps, mark);
+    }
+    FREE(mark);
+    return errcode;
+}
+
+//=============================================================================
+
+MathExpr* compileExpr(MathExpr *expr, int forPipes)
+/*
+**  Purpose:
+**    makes a copy of an expression whose variables refer to positions
+**    in the vector of variable values.
+**
+**  Input:
+**    expr = an expression
+**    forPipes = 1 for pipe chemistry, 0 for tank chemistry.
+**
+**  Returns:
+**    the compiled expression (NULL if out of memory).
+*/
+{
+    int j, i, type;
+    MathExpr *e = mathexpr_copy(expr);
+    if ( e == NULL ) return NULL;
+    for (j = 0; j < e->count; j++)
+    {
+        if ( e->node[j].opcode != 8 ) continue;
+        i = e->node[j].ivar;
+
+    // --- species: their concentration, or the value of their formula
+
+        if ( i >= 1 && i <= LastIndex[SPECIES] )
+        {
+            if ( forPipes ) type = MSX.Species[i].pipeExprType;
+            else            type = MSX.Species[i].tankExprType;
+            if ( type == FORMULA ) i += FormBase;
+        }
+
+    // --- terms, parameters & constants keep their index
+
+        else if ( i > LastIndex[SPECIES] && i <= LastIndex[CONSTANT] ) ;
+
+    // --- hydraulic variables (whose value is 0 in tanks)
+
+        else if ( forPipes && i > HydBase && i < HydBase + MAX_HYD_VARS ) ;
+
+    // --- anything else has a value of 0 (position 0 always holds 0)
+
+        else i = 0;
+        e->node[j].ivar = i;
     }
+    return e;
 }
 
+//=============================================================================
+
+int findDeps(ChemExprs *ce, MathExpr *expr, int *list, int *n, char *mark)
+/*
+**  Purpose:
+**    adds the terms and formula species that a compiled expression needs
+**    to a list, each after those that it needs itself.
+**
+**  Input:
+**    ce = compiled expressions
+**    expr = a compiled expression
+**    list = list of positions of terms and formula species
+**    n = number of items in list
+**    mark = status of each term or formula species (0 = not visited,
+**           1 = being visited, 2 = in the list).
+**
+**  Returns:
+**    an error code or 0 if no error.
+*/
+{
+    int j, i;
+    if ( expr == NULL ) return 0;
+    for (j = 0; j < expr->count; j++)
+    {
+        if ( expr->node[j].opcode != 8 ) continue;
+        i = expr->node[j].ivar;
+        if ( (i > LastIndex[SPECIES] && i <= LastIndex[TERM]) || i > FormBase )
+        {
+            if ( addDep(ce, i, list, n, mark) ) return ERR_MSX_INPUT;
+        }
+    }
+    return 0;
+}
+
+//=============================================================================
+
+int addDep(ChemExprs *ce, int i, int *list, int *n, char *mark)
+/*
+**  Purpose:
+**    adds a term or formula species (and those it needs) to a list.
+**
+**  Input:
+**    ce = compiled expressions
+**    i = position of the term or formula species
+**    list, n, mark = see findDeps.
+**
+**  Returns:
+**    an error code or 0 if no error.
+*/
+{
+    if ( mark[i] == 2 ) return 0;
+    if ( mark[i] == 1 ) return ERR_MSX_INPUT;
+    mark[i] = 1;
+    if ( findDeps(ce, ce->slotExpr[i], list, n, mark) ) return ERR_MSX_INPUT;
+    mark[i] = 2;
+    list[*n] = i;
+    (*n)++;
+    return 0;
+}
+
+//=============================================================================
+
+void freeExprs(ChemExprs *ce)
+/*
+**  Purpose:
+**    frees the memory used by compiled expressions.
+*/
+{
+    int i;
+    if ( ce->slotExpr )
+    {
+        for (i = LastIndex[SPECIES] + 1; i <= LastIndex[TERM]; i++)
+            mathexpr_delete(ce->slotExpr[i]);
+    }
+    if ( ce->speciesExpr )
+    {
+        for (i = 1; i <= NumSpecies; i++) mathexpr_delete(ce->speciesExpr[i]);
+    }
+    FREE(ce->slotExpr);
+    FREE(ce->speciesExpr);
+    FREE(ce->rateDeps);
+    FREE(ce->equilDeps);
+    FREE(ce->formulaDeps);
+    memset(ce, 0, sizeof(ChemExprs));
+}
+
+//=============================================================================
+
+void evalDeps(MathExpr **slotExpr, int *list, int n, double *val)
+/*
+**  Purpose:
+**    evaluates a list of terms and formula species.
+**
+**  Input:
+**    slotExpr = compiled expression of each term & formula species
+**    list = positions of the terms & formula species to evaluate, in
+**           order of dependency
+**    n = number of items in list
+**    val = vector of variable values.
+**
+**  Output:
+**    updated values of the terms & formula species in val.
+*/
+{
+    int j, i;
+    for (j = 0; j < n; j++)
+    {
+        i = list[j];
+        val[i] = mathexpr_evalVector(slotExpr[i], val);
+    }
+}
+
+//=============================================================================
+
+void setPipeValues(int k)
+/*
+**  Purpose:
+**    places the values of the parameters & constants of pipe k and of its
+**    hydraulic variables (from HydVar) in the vector of variable values.
+**
+**  Input:
+**    k = link index.
+*/
+{
+    int i;
+    double *val = ChemC1;
+    for (i = 1; i <= MSX.Nobjects[PARAMETER]; i++)
+        val[LastIndex[TERM] + i] = MSX.Link[k].param[i];
+    for (i = 1; i <= MSX.Nobjects[CONSTANT]; i++)
+        val[LastIndex[PARAMETER] + i] = MSX.Const[i].value;
+    for (i = 1; i < MAX_HYD_VARS; i++)
+        val[HydBase + i] = HydVar[i];
+}
+
+//=============================================================================
+
+void setTankValues()
+/*
+**  Purpose:
+**    places the values of the parameters & constants of the current tank
+**    node (TheNode) in the vector of variable values.
+*/
+{
+    int i, j;
+    double *val = ChemC1;
+    j = MSX.Node[TheNode].tank;
+    for (i = 1; i <= MSX.Nobjects[PARAMETER]; i++)
+    {
+        if ( j > 0 ) val[LastIndex[TERM] + i] = MSX.Tank[j].param[i];
+        else         val[LastIndex[TERM] + i] = 0.0;
+    }
+    for (i = 1; i <= MSX.Nobjects[CONSTANT]; i++)
+        val[LastIndex[PARAMETER] + i] = MSX.Const[i].value;
+}
