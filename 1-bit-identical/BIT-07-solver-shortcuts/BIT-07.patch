+char* findUnusedRateSpecies(int forPipes, int *errcode)
+/*
+**  Purpose:
+**    finds the rate species on which no rate depends, in pipes or tanks.
+**
+**  Input:
+**    forPipes = 1 for pipe chemistry, 0 for tank chemistry.
+**
+**  Output:
+**    errcode = set to ERR_MEMORY if memory runs out.
+**
+**  Returns:
+**    an array with an entry for each rate species (in the order of
+**    PipeRateSpecies or TankRateSpecies), 1 if no rate expression nor
+**    any term or formula it uses refers to that species, 0 if not.
+*/
+{
+    int i, m, n;
+    int *rateSpecies;
+    char *used, *unused;
+    MathExpr *expr;
+
+    n = forPipes ? NumPipeRateSpecies : NumTankRateSpecies;
+    rateSpecies = forPipes ? PipeRateSpecies : TankRateSpecies;
+    used = (char*)calloc(LastIndex[TERM] + 1, sizeof(char));
+    unused = (char*)calloc(NumSpecies + 1, sizeof(char));
+    if ( used == NULL || unused == NULL )
+    {
+        FREE(used);
+        FREE(unused);
+        *errcode = ERR_MEMORY;
+        return NULL;
+    }
+    for (i = 1; i <= n; i++)
+    {
+        m = rateSpecies[i];
+        expr = forPipes ? MSX.Species[m].pipeExpr : MSX.Species[m].tankExpr;
+        markUsedVariables(expr, forPipes, used);
+    }
+    for (i = 1; i <= n; i++) unused[i] = !used[rateSpecies[i]];
+    free(used);
+    return unused;
+}
+
+//=============================================================================
+
+void markUsedVariables(MathExpr *expr, int forPipes, char *used)
+/*
+**  Purpose:
+**    marks the species and terms that an expression refers to, directly
+**    or through the terms and formula species it uses.
+**
+**  Input:
+**    expr = a chemistry expression (as read from the input file)
+**    forPipes = 1 for pipe chemistry, 0 for tank chemistry.
+**
+**  Output:
+**    used[i] = 1 for each species or term i (in the numbering of
+**    LastIndex) referred to.
+*/
+{
+    int j, i, type;
+    MathExpr *e;
+
+    if ( expr == NULL ) return;
+    for (j = 0; j < expr->count; j++)
+    {
+        i = expr->node[j].ivar;           // a variable (-1 or 0 if none)
+        if ( i < 1 || i > LastIndex[TERM] || used[i] ) continue;
+        used[i] = 1;
+        e = NULL;
+        if ( i <= LastIndex[SPECIES] )
+        {
+            type = forPipes ? MSX.Species[i].pipeExprType
+                            : MSX.Species[i].tankExprType;
+            if ( type == FORMULA )
+                e = forPipes ? MSX.Species[i].pipeExpr
+                             : MSX.Species[i].tankExpr;
+        }
+        else e = MSX.Term[i - LastIndex[SPECIES]].expr;
+        markUsedVariables(e, forPipes, used);
+    }
+}
+
