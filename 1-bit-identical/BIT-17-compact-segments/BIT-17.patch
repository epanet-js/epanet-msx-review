+//=============================================================================
+
+void compactSegs(void)
+/*
+**   Purpose:
+**     copies the segments of every pipe and tank, from first to last,
+**     into the spare memory pool, which then becomes the pool in use.
+**
+**   Note:
+**     A segment is a block of memory, recycled through a last-in
+**     first-out list of free segments, so as pipes take new segments
+**     from that list their segments end up spread across the pool.
+**     After the copy, walking a pipe's segments (as the chemistry and
+**     transport routines do at every time step) reads memory in order.
+**     The copies have the same contents; only addresses change.
+*/
+{
+    int  k, n = MSX.Nobjects[LINK] + MSX.Nobjects[TANK];
+    long bytes = sizeof(struct Sseg) + 2*(MSX.Nobjects[SPECIES]+1)*sizeof(double);
+    Pseg seg, newseg, first, last;
+    alloc_handle_t *pool;
+
+    AllocSetPool(SparePool);
+    AllocReset();
+    for (k = 1; k <= n; k++)
+    {
+        // ... copy the chain (if memory runs out, both pools are kept and
+        //     the run stops with an error)
+        first = NULL;
+        last = NULL;
+        for (seg = MSX.FirstSeg[k]; seg != NULL; seg = seg->prev)
+        {
+            newseg = (struct Sseg *) Alloc(bytes);
+            if (newseg == NULL)
+            {
+                MSX.OutOfMemory = TRUE;
+                AllocSetPool(MSX.QualPool);
+                return;
+            }
+            memcpy(newseg, seg, bytes);
+            newseg->c = (double *) (newseg + 1);
+            newseg->lastc = newseg->c + MSX.Nobjects[SPECIES] + 1;
+            newseg->prev = NULL;
+            newseg->next = last;
+            if (last) last->prev = newseg;
+            else first = newseg;
+            last = newseg;
+        }
+
+        // ... switch the pipe or tank to its copied segments
+        if (first)
+        {
+            MSX.FirstSeg[k] = first;
+            MSX.LastSeg[k] = last;
+        }
+    }
+
+// --- the old pool's free segments are not needed any more
+
+    MSX.FreeSeg = NULL;
+    pool = MSX.QualPool;
+    MSX.QualPool = SparePool;
+    SparePool = pool;
+}
+
 //=============================================================================
 
